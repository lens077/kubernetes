# shellcheck shell=bash
# =============================================================================
# config.hosting.env —— 机房三节点(node4 控制面 / node5、node3 工作节点)的 config.env
#
# 安装器只读 bootstrap/config.env(lib/common.sh 写死), 本文件是"机房版"的完整副本:
#   rsync 仓库到节点后:  cp bootstrap/config.hosting.env bootstrap/config.env
# 与内网版(config.env)的差异全部来自 HOSTING-READINESS-2026-09-03.md §5, 生成方式:
#   以内网版为底, 只改标了 "机房" 注释的键; 其余键(版本、sysctl、组件容量)与内网版保持一致。
# 内网版改了公共键时, 重新生成本文件(或手工同步), 不要让两份长期分叉。
# =============================================================================
# =============================================================================
# config.env —— 安装器唯一的配置入口（所有可调参数集中在此，阶段脚本不再写死值）
#
# 约定:
#   - 值为 "ask"  : 交互模式下弹窗询问; 非交互(--yes)按各项默认行为处理
#   - 值为 ""     : 自动检测 / 自动解析最新版
#   - 布尔一律用 true/false 字符串
# =============================================================================

# ---------------------------------------------------------------------------
# 节点与集群
# ---------------------------------------------------------------------------
NODE_ROLE="control-plane"               # control-plane(控制面) / worker(工作负载节点)
                                        # worker: 只做系统调优+容器运行时+kubeadm join(+可选本地存储 VG);
                                        # 跳过 etcd 盘/Cilium 安装/helm/组件等集群级阶段
                                        # (Cilium agent 由控制面以 DaemonSet 自动调度到 worker, 无需本地安装)

# worker 加入参数(NODE_ROLE=worker 时使用; 在控制面执行
# `kubeadm token create --print-join-command` 获取; 交互模式下留空可直接粘贴整条命令)
# 三项支持环境变量传入(export 后以 root 直接 bash 执行, 或 sudo -E; 普通 sudo 会清环境)
JOIN_ENDPOINT="${JOIN_ENDPOINT:-}"      # 例 192.168.3.202:6443
JOIN_TOKEN="${JOIN_TOKEN:-}"            # 例 abcdef.0123456789abcdef (默认 24h 有效)
JOIN_CA_CERT_HASH="${JOIN_CA_CERT_HASH:-}"  # 例 sha256:e6a2...

NODE_NAME="node4"                          # 机房控制面; node5/node3 用 start.sh --worker(节点名取 hostname)
NODE_IP=""                              # 三节点共用配置, 按各自主路由自动检测 .101/.102/.103
POD_CIDR="10.244.0.0/16"
SERVICE_CIDR="10.96.0.0/12"
CLUSTER_DNS_DOMAIN="cluster.local"
SINGLE_NODE="true"                      # 控制平面 node101 同时接受工作负载
                                        # (仅控制面有效; 加入 worker 后可重新打污点隔离控制面, 见 README)
KUBELET_MAX_PODS="110"
KUBELET_SHUTDOWN_GRACE="90s"            # 优雅节点关机总预算(0s=关闭;仅支持整数 h/m/s 组合,如 1m30s)
KUBELET_SHUTDOWN_GRACE_CRITICAL="30s"   # 其中保留给关键 Pod(控制面静态 Pod 等)的部分,不得大于总预算
                                        # 50 阶段自动把总预算换算为秒并派生 logind InhibitDelayMaxSec
KCM_TERMINATED_POD_GC_THRESHOLD="20"    # 全局终态 Pod 数量超过此值后开始 GC;必须 >0,0 会关闭 GC

# apiserver 证书额外 SAN(为将来扩节点预留); NODE_IP/NODE_NAME 会自动并入, 无需重复
API_CERT_SANS=(10.10.21.161 10.10.21.162 10.10.21.163 node4 node5 node3
               127.0.0.1 localhost 211.144.221.229)   # 后三项给 ssh -L 隧道 / 机房端口映射的 kubectl 用

# 写入 /etc/hosts 的解析(托管块, 重复执行只更新不追加)
EXTRA_HOSTS=(
  "10.10.21.161 node4"
  "10.10.21.162 node5"
  "10.10.21.163 node3"
)

# ---------------------------------------------------------------------------
# 系统基础
# ---------------------------------------------------------------------------
TIMEZONE="Asia/Shanghai"
RUN_FULL_UPGRADE="true"                 # 新节点全自动升级基础系统包(含可能的内核更新)
DISABLE_SERVICES=(bluetooth avahi-daemon cups ModemManager)
ENABLE_AUTO_SECURITY_UPGRADES="true"    # unattended-upgrades 仅安全补丁; 不自动重启(重启交给 kured)
MITIGATIONS_OFF="false"                 # 内核参数 mitigations=off: 关闭 CPU 漏洞缓解换性能
                                        # 仅限完全可信的内网环境; ARM64(Apple 芯片)收益很小, 见 README

# chrony NTP 源(国内低延迟池)
NTP_POOLS=(
  "pool ntp.aliyun.com iburst maxsources 4"
  "pool ntp.tencent.com iburst maxsources 2"
)

# ---------------------------------------------------------------------------
# 网络(可选, 危险项: 改错会断网; 交互模式会二次确认)
# 注意: 写入独立的 /etc/netplan/99-k8s-static.yaml, 不覆盖系统原有 netplan 文件,
#       回滚只需删除该文件后 netplan apply
# ---------------------------------------------------------------------------
CONFIGURE_STATIC_IP="false"              # 机房三台已配静态地址(netplan 01-netcfg.yaml), 绝不在远程改网
NET_IFACE=""                            # 三台均可从默认路由自动检测为 enp0s5
NET_ADDRESS="10.10.21.161/24"           # 仅记录; 三台已是 netplan 静态地址, CONFIGURE_STATIC_IP=false 不会改网
NET_GATEWAY="10.10.21.254"
NET_DNS=(10.10.21.219 10.10.21.222)

# sshd(通过 /etc/ssh/sshd_config.d/ 下发, 按字段生效而非追加原文件)
CONFIGURE_SSHD="false"                  # root 公钥登录已可用, 保留现有 sshd 配置
SSHD_PERMIT_ROOT_LOGIN="yes"            # 危险项, 交互模式单独确认
SSHD_PUBKEY_AUTH="yes"

# ---------------------------------------------------------------------------
# 代理与镜像加速(国内环境)
# 四条独立通道, 各管一段(详见 README「网络通道」):
#   PROXY_URL        → 脚本自身的下载(GitHub 工件/helm 仓库/版本解析) + 可选的镜像预拉
#   GITHUB_PROXY     → 无本地代理时的 GitHub URL 前缀替代方案(有 PROXY_URL 就不需要它)
#   certs.d          → containerd 的 registry 级 mirror(拉镜像的主通道, 与代理无关)
#   K8S_IMAGE_REPO   → kubeadm 控制面镜像仓库(写进 kubeadm.yml 的那个)
# ---------------------------------------------------------------------------
PROXY_URL=""                            # 机房: 内网代理不可达, 留空=直连(脚本下载走 GITHUB_PROXY)
                                        # 不用来回改配置; 只影响脚本下载, 不影响 apt/集群流量
WRITE_PROXY_ALIASES="false"             # 机房: 没有代理, 不写别名
CONTAINERD_USE_PROXY="false"            # 常驻代理 drop-in 指向不通的代理会让除 NO_PROXY 外的镜像全拉不动
CONTAINERD_NO_PROXY_EXTRA="ccr.ccs.tencentyun.com,ghcr.io,.githubusercontent.com"
                                        # TCR/GHCR 已验证可直连；GHCR blob 会重定向到 githubusercontent.com
                                        # 2026-08-31 三节点直拉 27.8 MB：108～117 秒，237～257 kB/s
                                        # 临时预拉场景仍由 PREPULL_VIA_PROXY 控制
PREPULL_VIA_PROXY="false"               # 机房: 无代理可借
                                        #   50 阶段控制面镜像 + 60 阶段 Cilium 镜像(quay.io 直连慢)
                                        #   auto=代理在线就临时挂上、拉完即撤(推荐)
                                        #   true=强制(代理必须在线) / false=从不
GITHUB_PROXY="https://ghfast.top"       # 机房: github.com release 直连 9 次成功 1 次, ghfast.top 三台实测 200
                                        # 与 PROXY_URL 二选一即可, 代理在线时本项多余
USE_CN_MIRRORS="false"                  # true: 自动生成 DaoCloud 系 certs.d mirror + kubeadm 用阿里云仓库
CN_MIRROR_DOMAIN="m.daocloud.io"        # 上一项生成 mirror 时使用的域
CONTAINERD_CERTS_SRC="files/certs.d"                 # 自带完整 certs.d 目录(内含各 registry 的 hosts.toml):
                                        #   非空=原样安装到 /etc/containerd/certs.d, 优先级最高;
                                        #   留空时若安装器目录下存在 files/certs.d 也会自动采用，
                                        #   把整个安装器目录拷进需要安装的机器节点上（例如 rsync -av ~/lens077/kubernetes/bootstrap/ user@host:/root/k8s-system/）
K8S_IMAGE_REPO="registry.aliyuncs.com/google_containers" # kubeadm 镜像仓库, 与 USE_CN_MIRRORS 解耦:
                                        #   空=自动(USE_CN_MIRRORS?阿里云:registry.k8s.io)
                                        #   例 registry.aliyuncs.com/google_containers

# ---------------------------------------------------------------------------
# 版本控制
#   解析顺序: 此处显式指定 > versions.lock(上次解析结果,保证重复执行一致) >
#             GitHub API 最新版 > FALLBACK 兜底
#   FALLBACK 为 2026-08-15 查询到的最新稳定版
# ---------------------------------------------------------------------------
K8S_MINOR="1.36"                            # 例 "1.36"; 空=按 dl.k8s.io stable 自动解析
RUNC_VERSION="v1.5.1"                         # 例 "v1.5.1"
CONTAINERD_VERSION="v2.3.4"                   # 例 "v2.3.4"
CRICTL_VERSION="v1.36.0"                       # 例 "v1.36.0"; 建议与 K8S_MINOR 一致
CILIUM_VERSION="v1.20.1"                       # 例 "v1.20.1"
CILIUM_CLI_VERSION="v0.19.7"                   # 例 "v0.19.7"
HELM_VERSION="v4.2.4"                         # 例 "v4.2.4"
GATEWAY_API_VERSION="v1.6.1"                  # 例 "v1.6.1"
OPENEBS_VERSION="v4.5.1"                      # 例 "v4.5.1"

FALLBACK_K8S_STABLE="v1.36.3"
FALLBACK_RUNC="v1.5.1"
FALLBACK_CONTAINERD="v2.3.4"
FALLBACK_CRICTL="v1.36.0"
FALLBACK_CILIUM="v1.20.1"
FALLBACK_CILIUM_CLI="v0.19.7"
FALLBACK_HELM="v4.2.4"
FALLBACK_GATEWAY_API="v1.6.1"
FALLBACK_OPENEBS="v4.5.1"

# ---------------------------------------------------------------------------
# Cilium(eBPF 数据面; kube-proxy 已在 kubeadm 阶段跳过并由 Cilium 完全替代)
#   "auto" 取值的含义: BBR=内核>=5.18 自动启用; NETKIT=内核>=6.8 且 CONFIG_NETKIT 时自动启用
#   (BIG TCP 无 auto, 只有 true/false, true 时要求内核>=6.3)
#
# 此处只放"环境相关/需要拍板"的旋钮。以下参数已作为推荐值固化在生成的
# values(files/cilium-values.yaml, 模板在 scripts/60-cilium.sh 的 gen_cilium_values):
#   rollOutCiliumPods/operator.rollOutPods(配置变更自动滚动) | bpf.tproxy(L7 走 eBPF)
#   rollOutCiliumPods/operator.rollOutPods | bpf.distributedLRU + preallocateMaps=false
#   ciliumEndpointSlice | pmtuDiscovery | k8s.requireIPv4PodCIDR | bpfClockProbe
#   annotateK8sNode | loadBalancer.l7.backend=envoy | native 下跳过 iptables conntrack
#   authentication.enabled=false | agent/operator/envoy 只设 requests、不设 limits
# 机器相关旋钮集中在下方；详细选型、测量与在线升级手顺见 bootstrap/CILIUM.md。
# 已装集群可直接执行 start.sh --only 60-cilium：版本或 values 指纹变化会自动重跑
# preflight/镜像预拉/helm/wait/L2/连通性步骤，不再要求手工清空整个 60 阶段。
# ---------------------------------------------------------------------------
CILIUM_ROUTING_MODE="native"            # native(低延迟,同二层)/tunnel(vxlan,跨三层)
CILIUM_LB_ALGORITHM="maglev"            # maglev(一致性哈希)/random
CILIUM_LB_MODE="hybrid"                 # snat/dsr/hybrid(推荐: TCP走DSR保源IP少一跳, UDP走SNAT避分片坑)
                                        # dsr/hybrid 仅 native 路由可用; 单节点三者无差异, 多节点见收益
CILIUM_LB_ACCELERATION="disabled"      # disabled/best-effort/native(XDP)
                                        # 当前 virtio 网卡不支持 native XDP，禁用与运行实况一致；
                                        # 换成支持 native XDP 的物理网卡后再基于 bpftool 实测启用。
CILIUM_DEVICES=""                       # 数据面网卡; 空=自动(NET_IFACE 或默认路由网卡), 多网卡逗号分隔
CILIUM_ENABLE_LRP="false"               # Local Redirect Policy 机制开关(如 node-local-dns 场景);
                                        # 开了只是启用能力, 还需自行部署 node-local-dns 并 apply LRP CR
CILIUM_BBR="auto"                       # Pod 出口 BBR 拥塞控制(带宽管理器), 需内核>=5.18
CILIUM_BIGTCP="false"                   # IPv4 BIG TCP(内核>=6.3); 虚拟网卡收益有限, 按需开启
CILIUM_NETKIT="auto"                    # netkit 数据面替代 veth(接近主机网络性能)
                                        # auto: 内核>=6.8 且 CONFIG_NETKIT 已编译时自动启用
                                        # (与 XDP 无关; XDP 见上面的 CILIUM_LB_ACCELERATION)

# 机器规模相关旋钮：默认值适配当前 3×4 vCPU/约 6.2 GiB 节点。
# 改 map 比例会重建 CT/NAT map、打断长连接；先采集至少 24h pressure 基线并安排维护窗口。
# 资源只设 requests，不设 limits，避免网络关键进程因突发流量被 OOMKill。
CILIUM_BPF_MAP_DYNAMIC_SIZE_RATIO="0.01"
CILIUM_BPF_MAP_RESIZE_APPROVED="false"    # 满足 24h 基线并进入维护窗口后显式改 true；
                                          # live 比例与目标不同时，false 会阻止 Helm rollout。
CILIUM_AGENT_CPU_REQUEST="100m"
CILIUM_AGENT_MEMORY_REQUEST="512Mi"
CILIUM_OPERATOR_REPLICAS="1"             # 首装只有 node4; node5/node3 加入后改 2 并 start.sh --only 60-cilium
CILIUM_OPERATOR_CPU_REQUEST="50m"
CILIUM_OPERATOR_MEMORY_REQUEST="128Mi"
CILIUM_ENVOY_CPU_REQUEST="50m"
CILIUM_ENVOY_MEMORY_REQUEST="128Mi"
CILIUM_K8S_CLIENT_QPS="50"               # L2 Lease 数量、Service 变更率增大时按指标上调
CILIUM_K8S_CLIENT_BURST="100"
CILIUM_HUBBLE_EVENT_BUFFER_CAPACITY="4095"

CILIUM_ENABLE_HUBBLE="true"              # 流量观测：Relay + drop/DNS/TCP/flow 指标
CILIUM_ENABLE_HUBBLE_UI="false"
CILIUM_ENABLE_GATEWAY_API="true"        # L7 路由(Gateway API, 推荐)
CILIUM_ENABLE_INGRESS="false"           # 传统 Ingress 控制器(与 GatewayAPI 二选一即可)
CILIUM_GATEWAY_API_ALPN="false"         # HTTPS listener 是否协商 ALPN(h2/http1.1)。
                                        #   要用 GRPCRoute 经网关终结 TLS 就必须开;
                                        #   只跑 HTTP 时保持关(默认值, 少一层协商)
# LB-IPAM 池与 L2 通告是两个独立能力(lib/common.sh):
#   池 → LoadBalancer Service 能拿到地址(GatewayClass cilium 生成 LoadBalancer Service, 没有池就
#        永远 <pending>/Programmed=False); L2 → 同链路主机能 ARP 到该地址。
#   CILIUM_ENABLE_LB_IPAM: auto(默认: Gateway API 或 L2 任一开启即开) / true / false
#   下面三个地址留空时, 00-preflight 有终端就询问并存到 /var/lib/k8s-installer/lb-ipam.env(不改本文件),
#   无终端则报错; 显式写在这里永远优先。
CILIUM_ENABLE_LB_IPAM="auto"
# 机房当前保持 L2 开启(2026-09-06 两节点集群实测租约正常)。只经 newt/Pod 访问集群内 VIP 时它不是必需的:
# 改 false 只删 default-l2, 池与 Gateway 固定 VIP 不受影响(Pod → .240:443 路径已实测不依赖 L2)。
CILIUM_ENABLE_L2_ANNOUNCEMENTS="true"
# 机房版先用与 LAN/POD/SERVICE 都不重叠的集群内 VIP 段。它会被 Cilium 编程，Pod/newt 可访问(2026-09-06 实测)。
# 2026-09-04/06 从 node4 探测该段走默认网关、核心路由器不当公网转发、无响应/无 ARP —— 只是观测记录,
# 不是地址所有权; 机房对 10.10.31.0/24 的书面答复见 CILIUM.md §8.1, 若机房路由该段必须换段。
# 为消除组件并行安装竞态，Gateway 独占 .240 的 selector 池；其它 LoadBalancer 用 .241-.249。
CILIUM_GATEWAY_LB_IP="10.10.31.240"     # gateway-pool /32，Pangolin target 不随重建漂移
CILIUM_LB_POOL_START="10.10.31.241"     # default-pool 给 Consul、Postgres/Dragonfly 独立 Gateway 等
CILIUM_LB_POOL_STOP="10.10.31.249"
# 若以后向机房拿到专属 10.10.21.x VIP，两组值一起换成专属段即可获得真正的 LAN L2 直达。
CILIUM_ENABLE_IPSEC="false"             # 节点间透明加密(单节点无必要)
DISABLE_IPV6="true"                     # 系统与集群同时禁用 IPv6
CLUSTER_DOMAIN="dev.test"                # 组件对外域名后缀(components/*/gateway 的 hostname 按
                                        #   <组件>.$CLUSTER_DOMAIN 取默认值; 单个组件可在其
                                        #   component.env 里用 HOSTNAME 覆盖)

# ---------------------------------------------------------------------------
# etcd 专用磁盘与碎片整理(45 阶段; 单机上 etcd 与业务 IO 争抢是主要延迟抖动源)
# ---------------------------------------------------------------------------
ETCD_DEDICATED_DISK=""                  # 机房不能加盘; etcd 落根盘(node4 fsync 0.2ms 实测可接受)
                                        # ""=不启用; "/dev/sdX"=直接指定
                                        # 已初始化的集群也支持迁移(停 kubelet→搬数据→挂载→恢复)
ETCD_DISK_WIPE_OK="false"

# 没有整块空盘时的替代: 从系统盘尾部"未分配空间"(虚拟化层扩容后未划分)划出专用分区
# 注意: 同一块虚拟盘上的分区只有文件系统级隔离, 底层仍共享同一个 IO 队列与宿主文件 ——
#       etcd 想要的"IO 隔离"收益基本没有; 独立小虚拟盘(10-20G)永远是更优解
ETCD_PARTITION_OF=""                    # 例 /dev/sda; 非空时优先于 ETCD_DEDICATED_DISK
ETCD_PARTITION_SIZE="16G"
ETCD_DEFRAG_TIMER="true"                # systemd timer 周期性 etcdctl defrag(回收碎片空间)
ETCD_DEFRAG_CALENDAR="Sun *-*-* 03:17:00"  # OnCalendar 表达式(本地时区), 默认每周日凌晨

# ---------------------------------------------------------------------------
# 存储: OpenEBS LVM LocalPV
# ---------------------------------------------------------------------------
LVM_VG_NAME="openebs-vg"
LVM_DISKS=()                            # 无第二块盘
LVM_WIPE_OK="false"

# 没有整块空盘时的替代: 从系统盘尾部未分配空间划分区并入 VG(业务数据盘对同盘分区不敏感,
# 这里用分区是合理的; etcd 那种延迟敏感场景才必须独立盘)
LVM_PARTITION_OF=""                     # 根 LV 已用尽 VG(2026-09-03 lvextend +100%FREE), 盘尾无未分配空间
                                        # 无终端全自动需显式填盘并配 LVM_WIPE_OK=true
LVM_PARTITION_SIZE="0"                  # 用尽每台系统盘尾部全部剩余空间
LVM_ALLOW_LOOPBACK="true"               # 唯一可行路径: 根 ext4 上的回环文件(安装器自带开机重挂 unit)
LVM_LOOPBACK_SIZE="60G"                  # 稀疏文件按需占用; 三台根盘各余 88~131G
LVM_LOOPBACK_FILE="/var/openebs/openebs-lvm.img"
SC_NAME="openebs-lvm"
SC_FS_TYPE="xfs"                        # xfs 对数据库/大文件更稳; 可改 ext4
SC_SET_DEFAULT="true"

# ---------------------------------------------------------------------------
# 可选基础设施组件(交互模式会弹出多选菜单; --yes 时按此处取值)
# 内存预估仅作提示, 组件资源限制见 files/addons/ 生成的 values
# ---------------------------------------------------------------------------
ADDON_METRICS_SERVER="true"             # kubectl top / HPA 依赖   (~100Mi)
# —— 可观测性(菜单独立分组, o 键本组全选; 各项独立可选) ——
# 联动规则(由各 components/<组件>/install.sh 自行查集群判断, 编排器只负责选择与调度):
#   OTel Collector 的 exporters/pipelines 按所选后端动态生成:
#     vm→metrics(/opentelemetry/v1/metrics) | loki→logs(Loki 原生 /otlp) | jaeger→traces(:4317)
#     容器日志由 fluent-bit 负责, otel 的 logsCollection 特意关闭避免双份
#   Grafana 数据源同样按 vm/loki/jaeger 勾选动态预置(vm 为默认数据源)
#   Jaeger 用 files/jaeger/ 下你的精修 manifests 原样安装(ns observability,
#     PVC 的旧 SC 名 openebs-lvmpv 会在 apply 时替换为 SC_NAME), 网关暴露示例在 files/examples/
#   应用推送端点: otel-opentelemetry-collector.opentelemetry.svc:4317(gRPC)/4318(HTTP)
# 改端点/命名空间等固化值 → 直接改 80 脚本对应函数; 改完重跑:
#   start.sh --reset-state 80-components && start.sh --only 80-components
ADDON_VM="true"                         # VictoriaMetrics single, 指标后端 (~500Mi)
ADDON_GRAFANA="true"                    # 独立 Grafana(数据源按 vm/loki/jaeger 选择动态预置) (~300Mi)
ADDON_OTEL="true"                       # OTel Collector(otlp 4317/4318; 按后端生成 pipelines) (~200Mi)
ADDON_OTEL_NODE="true"                  # OTel Node Agent(DaemonSet, 只采主机指标, 每节点 ~64Mi)
ADDON_JAEGER="false"                    # 机房: 链路后端是 victoria-traces(2026-09-03), jaeger 退为次选
ADDON_ARGOCD="true"                    # GitOps                  (~500Mi)
ADDON_EXTERNAL_SECRETS="true"          # ESO: 线上 Vault(vault.apikv.com) → k8s Secret, L3 密钥层;
                                        #   重装后需重新注入 AppRole 凭据(见组件 README) (~150Mi,实测约110Mi)
ADDON_CNPG="true"                      # CloudNativePG 算子+自动建 pg-main 实例与 ecommerce 库(2026-08-21 起)
PG_CREATE_MAIN_CLUSTER="true"           #   ↑实例自动化开关; 规格另裁时置 false 退回手工 apply examples/
ADDON_STRIMZI="false"                  # ❌定稿退役(2026-08-20): Kafka 全家桶被 NATS JetStream 替代(ecommerce TECH-RADAR §1), 勿再装
ADDON_MEILISEARCH="false"               # 已退役；仅显式人工回滚时启用 (~400Mi)
                                        # 2026-08-16 拍板替代 OpenSearch/ES; 应用迁移任务见 ecommerce TODO.md
ADDON_DRAGONFLY="true"                 # Dragonfly 缓存(Redis 协议兼容, go-redis 零改动;
                                        #   对齐 cloud-native-deploy/dragonflydb 既有选型) (~512Mi)
ADDON_MINIO="false"                    # ❌残留已清(2026-08-20): 集群内 minio 无人使用(商品图走外部 minio.apikv.com); 上游已归档, 定稿迁 SeaweedFS
ADDON_HARBOR="false"                   # Harbor OCI 镜像仓库；当前 ARM64 集群等待官方 v2.16.0，
                                        #   v2.15.x 官方镜像只有 amd64，安装脚本会主动拦截 (~1.7Gi)
ADDON_CONSUL="true"                     # Consul 服务注册/KV 配置中心(ecommerce Kratos 服务
                                        #   注册发现 + ecommerce/<svc>/dev.yml 配置来源) (~200Mi)
ADDON_CERTMANAGER="true"                # 证书自动签发(GatewayAPI HTTPS 标配) (~150Mi)
ADDON_LOKI="false"                      # 机房: 日志后端是 victoria-logs + vector(2026-09-03)
                                        #   不装 Alloy, 对接方式见 files/examples) (~600Mi)
ADDON_FLUENT_BIT="false"                # 机房: 容器日志由 vector 采集
ADDON_KURED="true"                      # 内核补丁后在维护窗口内自动排空+重启 (~50Mi)
ADDON_NEWT="true"                       # 机房公网唯一入口: Pangolin/newt → 固定 Gateway VIP 或节点内网 IP
                                        # 凭据从 node3 收割; 安装前放 node4 /var/lib/k8s-installer/creds/newt-{id,secret} (~64Mi)
ADDON_VPA="true"                        # VPA 只装 recommender(不自动改, 出推荐值供手动校准
                                        #   resources; TODO 里"取值待 VPA 校准"的落地) (~200Mi)
ADDON_TEMPO="false"                     # Grafana Tempo 链路后端(评估期: jaeger 仍是主后端,
                                        #   双跑对比 TraceQL/badger 后再定去留) (~600Mi)
ADDON_REDIS="false"                     # 官方 OSS Redis 单机(技术验证; 缓存主力是 dragonfly,
                                        #   需要真 Redis 行为/模块能力时才开) (~300Mi)
ADDON_SEATA="false"                     # Seata TC 单副本(技术验证; ecommerce 的一致性走
                                        #   Outbox+Saga 不依赖它, 见组件 README) (~768Mi)
                                        # okteto 是本机 CLI 组件, 不占集群内存, 无开关

DRAGONFLY_MAXMEMORY="256mb"             # 缓存内存上限(cache_mode 满时按 LRU 淘汰)
DRAGONFLY_PROACTOR_THREADS="1"          # io 线程数; Dragonfly 要求 maxmemory >= 256MiB * 线程数,
                                        #   默认按 CPU 核数起线程会直接启动失败, 必须与上一行配套改
DRAGONFLY_CHART_VERSION=""              # 空=解析最新版并锁进 versions.lock(兜底 v1.40.1)
FLUENT_BIT_CHART_VERSION="0.58.1"       # 官方 chart 版本(app v5.1.1); 显式固定保证重复部署一致
REDIS_CHART_VERSION="0.34.17"           # CloudPirates chart(app 8.10.0); monorepo 的 tag 与单
                                        #   chart 版本对不上, 无法自动解析, 显式钉版本
TEMPO_CHART_VERSION="2.2.4"             # grafana-community chart(app 2.10.8); 3.x 是大重构别跟
VPA_CHART_VERSION="0.11.0"              # 官方 autoscaler chart(app 1.7.1); CRD 不随 helm 升级,
                                        #   升版本要手动 apply 新 CRD(见组件 README)
HARBOR_CHART_VERSION="1.19.2"           # 官方 chart 版本(app v2.15.2)；ARM64 暂不可安装，等待 v2.16
HARBOR_REGISTRY_STORAGE_SIZE="20Gi"     # OCI blob 与 manifest 主数据盘
HARBOR_JOB_STORAGE_SIZE="2Gi"           # 复制、扫描等异步任务日志
HARBOR_DATABASE_STORAGE_SIZE="5Gi"      # 内置 PostgreSQL 元数据盘
HARBOR_REDIS_STORAGE_SIZE="2Gi"         # 内置 Valkey 队列与缓存盘
HARBOR_TRIVY_STORAGE_SIZE="5Gi"         # Trivy 漏洞数据库缓存
MINIO_STORAGE_SIZE="20Gi"
JAEGER_STORAGE_SIZE="5Gi"                # badger 本地卷(7 天 span TTL; 迁移前 ES 里 7 天索引仅约 17MB)
MEILI_STORAGE_SIZE="10Gi"
CONSUL_STORAGE_SIZE="3Gi"               # raft+KV 数据盘(沿用 archive 旧值; KV 只存配置, 3Gi 足够)
VM_STORAGE_SIZE="8Gi"                   # VictoriaMetrics 数据盘(同你 victoriametrics/single 取值)
GRAFANA_STORAGE_SIZE="5Gi"              # Grafana 持久化(同你 grafana/helm 取值)
ARGOCD_VERSION=""                       # 空=解析最新版(兜底 v3.5.1); yaml manifest 安装
LOKI_RETENTION="168h"                   # 日志保留 7 天
LOKI_STORAGE_SIZE="10Gi"
TEMPO_RETENTION="168h"                  # trace 保留 7 天(对齐 jaeger 的 badger TTL)
TEMPO_STORAGE_SIZE="10Gi"
REDIS_STORAGE_SIZE="5Gi"                # AOF+RDB 数据盘
REDIS_MAXMEMORY="256mb"                 # redis maxmemory; 容器 limit 会按约 1.5 倍配套(AOF
                                        #   rewrite/fork 需要余量, 见组件 README)
SEATA_STORAGE_SIZE="2Gi"                # file store 的事务日志盘(store.mode=file)
ADDON_INSTALL_TIMEOUT="900"             # 单组件安装看门狗(秒): 超时杀掉该组件安装进程,
                                        # 计入失败但不阻塞其他组件; 重跑只补失败项
KURED_REBOOT_WINDOW_START="10:00"       # kured 允许重启的时间窗(本地时区)
KURED_REBOOT_WINDOW_END="15:00"

# ---------------------------------------------------------------------------
# 验收
# ---------------------------------------------------------------------------
VERIFY_PVC_SMOKE_TEST="true"           # 创建临时 PVC+Pod 验证存储链路后清理
VERIFY_LB_SMOKE_TEST="true"            # 验 LB-IPAM 分配、BPF Service 编程、L2 Lease；节点 curl VIP 只是加分项
VERIFY_OTEL_SMOKE_TEST="true"          # 往 OTel Collector 打真实 OTLP 指标/日志/链路, 再回查后端确认落库;
                                        #   只校验实际启用的后端(vm/loki/jaeger), 未装的自动跳过
RUN_CILIUM_CONNECTIVITY_TEST="true"    # cilium connectivity test 全量连通性测试(约 10 分钟)

# ---- 2026-08-20 技术选型定稿新增组件(ecommerce docs/TECH-RADAR.md 定稿版; 测试环境先行) ----
ADDON_NATS="true"                       # NATS JetStream 事件底座(替 Kafka 全家桶) (~450Mi)
ADDON_KEDA="true"                       # 事件驱动扩缩(cron/prometheus 先行)      (~200Mi)
ADDON_ARGO_ROLLOUTS="true"              # 金丝雀控制器(流量切分待 Consul 退役)    (~80Mi)
ADDON_KRUISE="false"                    # ❌暂缓(2026-08-20 实测否决:fail-closed pod webhook 冻结全集群, 见 DEPLOY-RECORD)
ADDON_VICTORIA_LOGS="true"              # 日志存储(拍板替 Loki, 双写过渡)         (~300Mi)
ADDON_VECTOR="true"                     # 日志采集(替 fluent-bit, VRL PII 脱敏)   (每节点~130Mi)
ADDON_CLICKHOUSE="false"                 # 埋点 OLAP 单节点(官方镜像 StatefulSet)  (~1100Mi)
ADDON_OPENFGA="true"                    # ReBAC 授权(store=CNPG pg-main 独立库)   (~300Mi)
ADDON_TRUST_MANAGER="true"              # CA bundle 分发(cert-manager 家族)       (~70Mi)
ADDON_OPENBAO="true"                    # 凭据后端(ESO 从它同步; 治理修订先行)     (~150Mi)
ADDON_KYVERNO="true"                    # 准入 policy(audit 14 天→enforce)        (~280Mi)
ADDON_SPEGEL="true"                     # P2P 镜像缓存试装(观察命中率)            (每节点~65Mi)
SPEGEL_MIRROR_PORT="30021"              # Spegel registry NodePort; 40 阶段把 http://本机IP:端口 注入每个 hosts.toml
                                        #   (先 P2P 再镜像站再回源; Spegel 组件不再接管 certs.d)

# ---- 2026-09-03 观测/告警/运维保障层(从 node3 Pigsty 收割回集群, 见 PIGSTY-HARVEST-2026-09-03.md
#      与 OBSERVABILITY-INTEGRATION.md; node3 重装后这些能力只存在于集群内) ----------------------
ADDON_VICTORIA_TRACES="true"            # VictoriaTraces 链路后端(OTel traces 直写; Grafana 用 jaeger 数据源读) (~300Mi)
ADDON_VMALERT="true"                    # vmalert: 规则评估(components/vmalert/rules/*.yml) → Alertmanager   (~100Mi)
ADDON_ALERTMANAGER="true"               # Alertmanager: 分组/抑制/静默, 唯一 receiver 是告警桥          (~64Mi)
ADDON_ALERT_BRIDGE="true"               # 告警桥: Alertmanager/Bugsink webhook → ntfy 推送 + 结构化日志   (~32Mi)
                                        #   ntfy 凭据: NTFY_URL/NTFY_TOPIC/NTFY_TOKEN 环境变量或 creds/ntfy.env;
                                        #   没配也能装(只记日志不推送), 补上后重跑 install.sh
ADDON_GATUS="true"                      # 合成监控: 探公网入口/集群内服务/观测链路是否真的有数据      (~64Mi)
ADDON_HEALTHCHECKS="true"               # 死人开关: 备份/CronJob 不按时 ping 就告警                  (~200Mi)
ADDON_BUGSINK="true"                    # 错误追踪(Sentry 协议), 事件经告警桥推 ntfy                 (~512Mi)

VT_STORAGE_SIZE="5Gi"                   # VictoriaTraces 数据盘
VT_RETENTION="7d"                       # 链路保留期(node3 用 15d; 集群内先按 7d, 与 VL 对齐)
VT_DISK_CAP="4GiB"                      # 按磁盘用量的保留上限, 必须 < VT_STORAGE_SIZE(撑满 PVC 会崩)
ALERTMANAGER_STORAGE_SIZE="512Mi"       # 静默与通知状态(nflog/silences); xfs 最小 300MB, 低于此 mkfs 失败
GATUS_STORAGE_SIZE="1Gi"                # sqlite 探测历史
HEALTHCHECKS_STORAGE_SIZE="1Gi"         # sqlite
BUGSINK_STORAGE_SIZE="5Gi"              # sqlite 事件库(WAL 模式)
BUGSINK_EVENT_RETENTION_DAYS="90"       # 事件保留天数(MAX_EVENT_AGE_DAYS)

# ---- 重建须知(2026-08-20 就绪审计, 重装集群前逐条过) ------------------------------
# 1. creds 先带走: 老节点 /var/lib/k8s-installer/creds/(或操作机 ~/.local/state/k8s-installer/creds/)
#    整目录拷到新环境同路径。尤其 dragonfly-password —— ecommerce 十份 bootstrap 与
#    config-center 自举配置里写的是这个密码(host-only 切换的代价); 不带走就要在重建后
#    把新密码同步进 Config Center(消费者三查清单见 ecommerce 仓 config 域 experience)。
# 2. pg-main 已自动化(2026-08-21 订正, 原「手工步骤」描述过时): ADDON_CNPG=true 且
#    PG_CREATE_MAIN_CLUSTER=true 时, postgres 组件 install.sh 自动完成
#    算子 → examples/pg-cluster.yaml → examples/pg-database.yaml(ecommerce 库), 幂等实测;
#    规格另裁时置 PG_CREATE_MAIN_CLUSTER=false 退回手工 apply examples/ 两份。
#    (openfga 的独立库由其 install.sh 自带 CR 声明, 无需手工)
# 3. 应用层不归本安装器: ecommerce 服务/网关/config-center/ArgoCD Application 的重建
#    走 ecommerce 仓 TODO「2026-08-19 集群重建后 GitOps 重新接线」同款流程,
#    交接总览见 ecommerce/docs/reports/2026-08-20.md。
# 4. 时序前置已解除(2026-08-21 订正): ecommerce 的 migrations 体系已提交(92be852,
#    goose migrations+seeds+内嵌 dbmigrate); 重建灌库走 ecommerce `make migrate-cnpg-up`
#    (一键真库建表, 12 迁移在现集群 CNPG 实测全过)。
# 5. 数据随重建清零(OpenBao/VictoriaLogs/ClickHouse/PG): 备份三件套系用户拍板暂缓
#    (ecommerce TECH-RADAR 10.3, 三个重启触发条件), 重建即接受数据丢弃。
# 6. spegel 的 containerd config_path 前提由本安装器 runtime 阶段保证(两节点已实测)。
