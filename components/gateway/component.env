# shellcheck shell=bash
ID=gateway
NAMESPACE=default
GROUP=base
CONFIG_VAR=""                    # 无独立开关: Gateway API 由 CILIUM_ENABLE_GATEWAY_API 控制
DEFAULT_ENABLED=true
DEPENDS_ON="cert-manager"        # 443 listener 的泛域名证书由 global-ca-issuer 签
EST_MEM_MI=0                     # 没有自己的工作负载, Envoy 由 Cilium 提供
READY_CHECK=""                   # 就绪判据是 Gateway Programmed, 不是 rollout, 见 install.sh

HELM_REPO=""                     # 纯 manifest, 无 chart
HELM_CHART=""
RELEASE=cilium-gateway

EXPOSE=none                      # 它本身就是暴露入口
