# shellcheck shell=bash
ID=vmalert
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_VMALERT
DEFAULT_ENABLED=false
DEPENDS_ON="victoriametrics alertmanager"   # 数据源=VM, notifier=Alertmanager
EST_MEM_MI=100
READY_CHECK="deploy/vmalert"

HELM_REPO="vm https://victoriametrics.github.io/helm-charts/"
HELM_CHART="vm/victoria-metrics-alert"
CHART_VERSION="0.47.0"           # app v1.150.0(2026-08-17); 固定版本便于复现与回滚
RELEASE=vmalert                  # server.fullnameOverride=vmalert → deploy/svc 都叫 vmalert

EXPOSE=http                      # vmalert 自带的规则/告警页面(只读), 经共享网关
HOSTNAME=vmalert.dev.test
