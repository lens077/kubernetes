# shellcheck shell=bash
ID=grafana
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_GRAFANA
DEFAULT_ENABLED=true
DEPENDS_ON="victoriametrics victoria-logs victoria-traces alertmanager"   # 只为排序: 数据源按实际装了哪些后端预置(loki/jaeger 装了也会被发现)
EST_MEM_MI=300
READY_CHECK="deploy/grafana"

# 2026-09-22: 原 grafana/grafana chart 已被上游标记 deprecated —— 它停在 appVersion 12.3.1,
#   装出来的永远是 Grafana 12, 且 helm 每次都打 "this chart is deprecated"。
#   上游把 chart 迁到了 grafana-community/helm-charts(2026-01-30 起只在新仓库更新),
#   新仓库的 chart 版本号与 Grafana 版本对齐: chart 13.2.5 → appVersion 13.2.2。
#   所以这里换仓库 + 换 chart 名; 不要再指回 grafana/grafana。
HELM_REPO="grafana-community https://grafana-community.github.io/helm-charts"
HELM_CHART="grafana-community/grafana"
CHART_VERSION="13.2.5"           # pin the cached chart for reproducible cluster rebuilds (appVersion 13.2.2)
RELEASE=grafana

EXPOSE=http
HOSTNAME=grafana.dev.test
