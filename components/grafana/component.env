# shellcheck shell=bash
ID=grafana
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_GRAFANA
DEFAULT_ENABLED=true
DEPENDS_ON="victoriametrics victoria-logs victoria-traces alertmanager"   # 只为排序: 数据源按实际装了哪些后端预置(loki/jaeger 装了也会被发现)
EST_MEM_MI=300
READY_CHECK="deploy/grafana"

HELM_REPO="grafana https://grafana.github.io/helm-charts"
HELM_CHART="grafana/grafana"
RELEASE=grafana

EXPOSE=http
HOSTNAME=grafana.dev.test
