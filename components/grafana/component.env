# shellcheck shell=bash
ID=grafana
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_GRAFANA
DEFAULT_ENABLED=true
DEPENDS_ON="victoriametrics loki jaeger"   # 数据源按实际装了哪些后端预置
EST_MEM_MI=300
READY_CHECK="deploy/grafana"

HELM_REPO="grafana https://grafana.github.io/helm-charts"
HELM_CHART="grafana/grafana"
RELEASE=grafana

EXPOSE=http
HOSTNAME=grafana.app.com
