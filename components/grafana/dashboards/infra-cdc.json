{
  "uid": "infra-cdc",
  "title": "Kafka / CDC · 位点与对账证据",
  "id": null,
  "version": 3,
  "schemaVersion": 42,
  "editable": true,
  "description": "",
  "tags": [
    "infrastructure",
    "alerting",
    "evidence"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Connect task 当前状态",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_connect_connector_task_status{connector=~\"$connector\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "filterable": true,
            "wrapText": true,
            "wrapHeaderText": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "enablePagination": true
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "connector": true,
              "task": true,
              "status": true,
              "Value": true
            },
            "renameByName": {
              "connector": "连接器",
              "task": "任务",
              "status": "状态",
              "Value": "状态标志"
            },
            "indexByName": {
              "connector": 0,
              "task": 1,
              "status": 2,
              "Value": 3
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Debezium 源库连接",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(debezium_metrics_connected{context=\"streaming\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "指标缺失",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "断开",
                  "color": "red"
                },
                "1": {
                  "text": "已连接",
                  "color": "green"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "指标缺失",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "源库事件落后",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(debezium_metrics_millisecondsbehindsource{context=\"streaming\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": ""
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "指标缺失",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "空闲 / 无事件",
                  "color": "blue"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "指标缺失",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "PG / ES 行数差",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abs(max by(cdc_table)(cnpg_cdc_rows_count) - on(cdc_table) max by(cdc_table)(cdc_es_docs_count))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "filterable": true,
            "wrapText": true,
            "wrapHeaderText": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "enablePagination": true
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "cdc_table": true,
              "Value": true
            },
            "renameByName": {
              "cdc_table": "表",
              "Value": "行数差"
            },
            "indexByName": {
              "cdc_table": 0,
              "Value": 1
            }
          }
        }
      ]
    },
    {
      "id": 5,
      "title": "复制槽保留 WAL",
