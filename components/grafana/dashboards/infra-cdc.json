    {
      "id": 9,
      "title": "状态与进展分开看",
      "type": "text",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 3
      },
      "description": "",
      "options": {
        "mode": "markdown",
        "content": "**Task running 不证明位点推进。** 联看复制槽 WAL、消费 lag 和 PG/ES 对账。Debezium 延迟 `-1` 表示空闲无事件，不是负延迟。\n\n连接器筛选作用于 task；复制槽与对账仍显示链路级证据，避免把别的来源静默过滤掉。"
      }
    },
    {
      "id": 10,
      "title": "该类当前告警与排查",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 10
      },
      "description": "实时读取 vmalert annotations 与对象标签。条件持续时间从 activeAt 起算，包含 pending 等待；持续提醒不是独立故障。",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "ds-alert-evidence"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "ds-alert-evidence"
          },
          "type": "json",
          "source": "url",
          "format": "table",
          "parser": "jq-backend",
          "url": "http://vmalert.observability.svc.cluster.local:8880/api/v1/alerts",
          "url_options": {
            "method": "GET"
          },
          "root_selector": "# Read-only presentation of vmalert /api/v1/alerts. Do not infer a root cause.\ndef fallback($value; $other): if $value == null or $value == \"\" then $other else $value end;\ndef row:\n  . as $a | (.labels // {}) as $l |\n  fallback($l.exported_alertname; $a.name) as $origin |\n  fallback($l.exported_alertgroup; $l.alertgroup) as $group |\n  fallback($l.k8s_namespace_name; fallback($l.namespace; \"\")) as $ns |\n  fallback($l.k8s_pod_name; fallback($l.pod; \"\")) as $alert_pod |\n  fallback($l.k8s_node_name; fallback($l.node; \"\")) as $alert_node |\n  (if $group == \"cnpg\" then \"infra-cnpg\"\n   elif $group == \"ecommerce-cdc\" then \"infra-cdc\"\n   elif $group == \"ecommerce-k8s\" and $a.name != \"AlertFiringTooLong\" then \"infra-kubernetes\"\n   elif $group == \"ecommerce-security\" or $group == \"observability-pipeline\" or $group == \"ecommerce-observability-readiness\" then \"infra-observability\"\n   elif $ns != \"\" then \"infra-kubernetes\" else \"infra-overview\" end) as $target |\n  (if $target == \"infra-cnpg\" then \"数据库 / 备份\"\n   elif $target == \"infra-cdc\" then \"CDC / 位点\"\n   elif $target == \"infra-kubernetes\" then \"工作负载\"\n   elif $target == \"infra-observability\" then \"采集 / 网络\" else \"基础设施\" end) as $destination |\n  (try ($a.activeAt | sub(\"\\\\.[0-9]+Z$\"; \"Z\") | fromdateiso8601) catch null) as $started |\n  ([$l.cnpg_cluster, $ns, $alert_pod, $l.k8s_container_name, $l.k8s_deployment_name,\n    $alert_node, $l.connector, $l.slot_name, $l.service_name, $l.cdc_table, $l.exporter]\n    | map(select(. != null and . != \"\")) | unique | join(\" · \")) as $objects |\n  (if $ns != \"\" then \"kubernetes.pod_namespace:=\" + ($ns | tojson) +\n     (if $alert_pod != \"\" then \" AND kubernetes.pod_name:=\" + ($alert_pod | tojson) else \"\" end)\n   else \"\" end) as $logs |\n  {\n    key: ($a.group_id + \":\" + $a.id),\n    kind: (if $a.name == \"AlertFiringTooLong\" then \"reminder\" else \"problem\" end),\n    kind_label: (if $a.name == \"AlertFiringTooLong\" then \"持续提醒\" else \"原始告警\" end),\n    state: $a.state,\n    severity: fallback($l.severity; \"unknown\"),\n    summary: fallback($a.annotations.summary; $a.name),\n    description: fallback($a.annotations.description; \"规则未提供排查说明；查看表达式与实际标签。\"),\n    rule: $a.name,\n    original_rule: $origin,\n    resource: fallback($objects; fallback($l.cluster; \"标签未提供具体对象\")),\n    cluster: fallback($l.cluster; \"\"),\n    namespace: $ns, pod: $alert_pod, node: $alert_node,\n    cnpg_cluster: fallback($l.cnpg_cluster; \"\"),\n    connector: fallback($l.connector; \"\"),\n    active_at: $a.activeAt,\n    condition_seconds: (if $started == null then null else ([0, now - $started] | max) end),\n    value: $a.value,\n    expression: $a.expression,\n    restoring: ($a.restored // false),\n    stabilizing: ($a.stabilizing // false),\n    labels: $l,\n    detail_url: (\"/d/alert-instance-detail?var-instance=\" + (($a.group_id + \":\" + $a.id) | @uri)),\n    evidence: $destination,\n    evidence_url: (\"/d/\" + $target +\n      \"?var-cnpg_cluster=\" + (fallback($l.cnpg_cluster; \".*\") | @uri) +\n      \"&var-namespace=\" + (fallback($ns; \".*\") | @uri) +\n      \"&var-pod=\" + (fallback($alert_pod; \".*\") | @uri) +\n      \"&var-node=\" + (fallback($alert_node; \".*\") | @uri) +\n      \"&var-connector=\" + (fallback($l.connector; \".*\") | @uri) +\n      \"&var-rule=\" + ($origin | @uri)),\n    logs: (if $logs == \"\" then \"先在证据页选择对象\" else \"查看对象日志\" end),\n    logs_url: (if $logs == \"\" then null else\n      \"/explore?schemaVersion=1&panes=\" + ({\n        logs: {datasource:\"ds-vlogs\", queries:[{refId:\"A\", datasource:{type:\"victoriametrics-logs-datasource\",uid:\"ds-vlogs\"},expr:$logs,queryType:\"instant\"}],\n          range:{from:(if $started == null then \"now-6h\" else (($started-300)*1000|floor|tostring) end),to:\"now\"}}\n      } | tojson | @uri) end)\n  } | .logs_url = (.logs_url // .evidence_url);\nif .status != \"success\" or (.data.alerts | type) != \"array\" then\n  error(\"vmalert alert API did not return a successful alerts array\")\nelse\n  [.data.alerts[] | select(.name != \"Watchdog\") | row]\n  | sort_by([if .severity == \"critical\" then 0 else 1 end, .kind, .active_at, .key])\nend\n\n| map(select(.labels.alertgroup == \"ecommerce-cdc\" or .labels.exported_alertgroup == \"ecommerce-cdc\"))",
          "columns": [
            {
              "selector": "state",
              "text": "state",
              "type": "string"
            },
            {
              "selector": "kind_label",
              "text": "kind_label",
              "type": "string"
            },
            {
              "selector": "severity",
              "text": "severity",
              "type": "string"
            },
            {
              "selector": "summary",
              "text": "summary",
              "type": "string"
            },
            {
              "selector": "resource",
              "text": "resource",
              "type": "string"
            },
            {
              "selector": "condition_seconds",
              "text": "condition_seconds",
              "type": "number"
            },
            {
              "selector": "description",
              "text": "description",
              "type": "string"
            },
            {
              "selector": "evidence",
              "text": "evidence",
              "type": "string"
            },
            {
              "selector": "logs",
              "text": "logs",
              "type": "string"
            },
            {
              "selector": "key",
              "text": "key",
              "type": "string"
            },
            {
              "selector": "original_rule",
              "text": "original_rule",
              "type": "string"
            },
            {
              "selector": "detail_url",
              "text": "detail_url",
              "type": "string"
            },
            {
              "selector": "evidence_url",
              "text": "evidence_url",
              "type": "string"
            },
            {
              "selector": "logs_url",
              "text": "logs_url",
              "type": "string"
            }
          ],
          "filters": []
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "auto",
        "enablePagination": true,
        "pageSize": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true,
            "wrapText": true,
            "wrapHeaderText": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "state"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "状态"
              },
              {
                "id": "custom.width",
                "value": 75
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "firing": {
                        "text": "触发中",
                        "color": "red"
                      },
                      "pending": {
                        "text": "等待确认",
                        "color": "orange"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "kind_label"
            },
            "properties": [
