    {
      "id": 2,
      "title": "CPU 忙碌率",
      "type": "bargauge",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 6,
        "h": 8
      },
      "description": "共享 host:cpu_busy_ratio；跨核平均，不包含 idle 与 iowait。",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((host:cpu_busy_ratio) and (time() - timestamp(host:cpu_busy_ratio) < 180) and on(host,host_kind) (host:signal_present{signal=\"cpu\"} == 1) and on(host,host_kind) (time() - timestamp(host:signal_present{signal=\"cpu\"}) < 180) and on(host,host_kind) host:expected_info and on(host,host_kind) (time() - host:last_seen_timestamp_seconds < 180)) and on() (time() - host:rules_evaluation_timestamp_seconds < 180)) or on(host,host_kind) (group by(host,host_kind) (host:expected_info) * -1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "{{host}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "noValue": "指标缺失",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "指标缺失",
                  "color": "gray"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
