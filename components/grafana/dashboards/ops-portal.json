    {
      "id": 9,
      "title": "预期主机覆盖 · 缺一项也不算齐全",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 9
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min by(host,host_kind) (host:signal_present and (time() - timestamp(host:signal_present) < 180)) and on(host,host_kind) (count by(host,host_kind) (host:signal_present and (time() - timestamp(host:signal_present) < 180)) == 4) and on() (time() - host:rules_evaluation_timestamp_seconds < 180)) or on(host,host_kind) (host:expected_info * -1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "filterable": true,
            "wrapText": true,
            "wrapHeaderText": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "指标覆盖"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "四类指标齐全",
                        "color": "green"
                      },
                      "0": {
                        "text": "部分指标缺失",
                        "color": "orange"
                      },
                      "-1": {
                        "text": "规则数据缺失 / 延迟",
                        "color": "gray"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "enablePagination": false
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "host": true,
