      "description": "这是 etcd 自身按响应码统计的服务端请求，不是 apiserver 转发量。",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(code)(rate(etcd_server_client_requests_total[$__rate_interval]))",
