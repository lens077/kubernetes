      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "k8s_pod_name": true,
              "Value": true
            },
            "renameByName": {
              "k8s_pod_name": "Pod",
              "Value": "连接客户端"
            },
            "indexByName": {
              "k8s_pod_name": 0,
              "Value": 1
            }
          }
        }
