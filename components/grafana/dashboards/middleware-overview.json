  "schemaVersion": 42,
  "editable": true,
  "description": "三个组件各一组：容量、健康、命中率与队列；所有指标已在 VM 验证存在。",
  "tags": [
    "infrastructure",
    "alerting",
    "evidence"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
