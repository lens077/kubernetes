    {
      "id": 3,
      "title": "Keyspace 命中率",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 3
      },
      "description": "命中 /（命中 + 未命中）；没有流量时显示 0，不冒充命中。",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(dragonfly_keyspace_hits_total[$__rate_interval])) / clamp_min(sum(rate(dragonfly_keyspace_hits_total[$__rate_interval])) + sum(rate(dragonfly_keyspace_misses_total[$__rate_interval])), 1)",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "instant": true,
          "range": false,
          "legendFormat": ""
