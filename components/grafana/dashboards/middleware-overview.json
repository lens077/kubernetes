      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "filterable": true,
            "wrapText": true,
            "wrapHeaderText": true,
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "md",
        "enablePagination": true
