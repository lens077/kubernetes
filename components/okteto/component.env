# shellcheck shell=bash
# okteto 是**本机 CLI 组件**: 集群里没有常驻工作负载, install.sh 只做客户端自检 +
# 集群侧前置条件校验。因此没有 CONFIG_VAR 开关(没有可关的东西), EST_MEM_MI=0。
# `okteto up` 期间才会临时在目标命名空间产生 <name>-okteto 资源, down 后消失。
ID=okteto
NAMESPACE=default                # 无常驻资源; 占位值, 实际作用于 okteto up 的目标命名空间
GROUP=infra
CONFIG_VAR=""
DEFAULT_ENABLED=false            # 编排器菜单里默认不选: 它不装东西, 按需手动跑
DEPENDS_ON=""
EST_MEM_MI=0
READY_CHECK=""                   # 无工作负载可等

HELM_REPO=""
HELM_CHART=""
RELEASE=okteto

EXPOSE=none                      # 同步与端口转发全经 apiserver 的 port-forward 隧道
