# shellcheck shell=bash
ID=openbao
NAMESPACE=openbao
GROUP=infra
CONFIG_VAR=ADDON_OPENBAO
DEFAULT_ENABLED=false
DEPENDS_ON="external-secrets"
EST_MEM_MI=150
READY_CHECK="statefulset/openbao"

HELM_REPO="openbao https://openbao.github.io/openbao-helm"
HELM_CHART="openbao/openbao"
RELEASE=openbao

EXPOSE=none
