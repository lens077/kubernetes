# shellcheck shell=bash
ID=minio
NAMESPACE=minio
GROUP=infra
CONFIG_VAR=ADDON_MINIO
DEFAULT_ENABLED=true
DEPENDS_ON="external-secrets"    # root 凭据经 ESO 从 OpenBao 物化(install.sh 有 get_cred 降级)
EST_MEM_MI=300
READY_CHECK="deploy/minio"

HELM_REPO=""                     # 不用 chart: 用 pgsty/silo 镜像的单实例 manifest
HELM_CHART=""
RELEASE=minio

EXPOSE=http
HOSTNAME=silo.apikv.com           # 线上控制台; S3 API 复用 silo-api.apikv.com(见 gateway/)
