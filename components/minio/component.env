# shellcheck shell=bash
ID=minio
NAMESPACE=minio
GROUP=infra
CONFIG_VAR=ADDON_MINIO
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=300
READY_CHECK="deploy/minio"

HELM_REPO=""                     # 不用 chart: 用 pgsty/silo 镜像的单实例 manifest
HELM_CHART=""
RELEASE=minio

EXPOSE=http
HOSTNAME=minio-ui.app.com        # 控制台; S3 API 走 s3.app.com(见 gateway/)
