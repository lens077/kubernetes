# shellcheck shell=bash
ID=consul
NAMESPACE=consul
GROUP=infra
CONFIG_VAR=ADDON_CONSUL
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=200
READY_CHECK="statefulset/consul-server"

HELM_REPO="hashicorp https://helm.releases.hashicorp.com"
HELM_CHART="hashicorp/consul"
RELEASE=consul

EXPOSE=http                      # UI 走共享网关; HTTP API 另有 exposeService LB(见 README)
HOSTNAME=""                      # 默认 consul.$CLUSTER_DOMAIN

# 依赖契约(2026-09-11): 服务发现; 当前无 ACL、无 TLS(schema 的 discovery.consul 也没有 token 字段)
PROVIDES=consul
SVC=consul-server.consul.svc
PORT=8500
SCHEME=http
DEV_PORT=443                     # dev 经共享网关 https://consul.$CLUSTER_DOMAIN(需带 CA)
DEV_SCHEME=https
CA_REF=secret:cert-manager/global-root-ca-secret:ca.crt   # 只有 gateway(dev LAN)策略用
REMOTE_HOST=consul-dev.apikv.com # pangolin 策略: Pangolin HTTP 资源 consul-dev(sso 关, tlsServerName/Host=consul.dev.test)→ node4/node5 newt → 10.10.31.240:443
REMOTE_PORT=443
REMOTE_SCHEME=https
REMOTE_CA=public                 # Traefik 终止 TLS, 公共可信泛证书 → ca_pem 留空
