# shellcheck shell=bash
ID=metrics-server
NAMESPACE=kube-system
GROUP=base
CONFIG_VAR=ADDON_METRICS_SERVER
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=100
READY_CHECK="deploy/metrics-server"

HELM_REPO="metrics-server https://kubernetes-sigs.github.io/metrics-server/"
HELM_CHART="metrics-server/metrics-server"
RELEASE=metrics-server

EXPOSE=none
