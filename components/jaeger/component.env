# shellcheck shell=bash
ID=jaeger
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_JAEGER
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=400
READY_CHECK="deploy/jaeger"

HELM_REPO=""                     # 不用 chart: v2 all-in-one 用仓库里精修的 manifests
HELM_CHART=""
RELEASE=jaeger

EXPOSE=http
HOSTNAME=jaeger.dev.test
