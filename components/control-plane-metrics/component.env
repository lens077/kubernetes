# shellcheck shell=bash
# =============================================================================
# 控制面进程级指标采集（2026-11-25 新增）
#
# 与 components/opentelemetry（Deployment, OTLP 入口）和
# components/opentelemetry-node（DaemonSet, hostmetrics）是第三类信号：
# 只运行在 k1，用 hostNetwork 直接抓四个控制面静态 Pod 本机的 /metrics。
# 这三类指标此前在 VM 中为零条；Pod phase 只能证明静态 Pod 还在，
# 不能证明 etcd 有 leader、apiserver 延迟正常或 leader lease 没丢。
# =============================================================================
ID=control-plane-metrics
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_CONTROL_PLANE_METRICS
DEFAULT_ENABLED=true
DEPENDS_ON="victoriametrics"     # 写入目标；不依赖集群内 otel collector
EST_MEM_MI=128
READY_CHECK="deploy/control-plane-metrics"

HELM_REPO=""
HELM_CHART=""
RELEASE=control-plane-metrics

EXPOSE=none                      # 只出不进：不接收 OTLP、不暴露抓取端点给外部
