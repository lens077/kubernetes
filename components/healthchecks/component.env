# shellcheck shell=bash
ID=healthchecks
NAMESPACE=ops
GROUP=obs
CONFIG_VAR=ADDON_HEALTHCHECKS
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=200
READY_CHECK="deploy/healthchecks"

HELM_REPO=""                     # 官方镜像 + sqlite, 自写 manifest
HELM_CHART=""
RELEASE=healthchecks

EXPOSE=http
HOSTNAME=hc.apikv.com   # 2026-09-15 pgBackRest 心跳从 node3 docker 副本切到集群(ecommerce 仓 B 组摘除), ping 经 Pangolin
