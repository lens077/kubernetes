# shellcheck shell=bash
ID=alertmanager
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_ALERTMANAGER
DEFAULT_ENABLED=false
DEPENDS_ON="alert-bridge"        # 唯一 receiver 是告警桥; 先装桥, 这里的 webhook 才有对象
EST_MEM_MI=64
READY_CHECK="statefulset/alertmanager"

HELM_REPO="prometheus-community https://prometheus-community.github.io/helm-charts"
HELM_CHART="prometheus-community/alertmanager"
CHART_VERSION="1.42.0"           # app v0.34.0; 固定版本便于复现与回滚
RELEASE=alertmanager             # fullname 即 alertmanager → svc alertmanager:9093

EXPOSE=http
HOSTNAME=alerts.dev.test
