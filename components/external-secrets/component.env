# shellcheck shell=bash
ID=external-secrets
NAMESPACE=external-secrets
GROUP=infra
CONFIG_VAR=ADDON_EXTERNAL_SECRETS
DEFAULT_ENABLED=false            # 刻意 false(全仓唯一):它依赖外部 Vault + 手工注入 AppRole 凭据,
                                 #   config.env 缺失该开关时宁可不装也不要装出一个 NotReady 的空壳。
                                 #   本集群实际由 config.env 的 ADDON_EXTERNAL_SECRETS="true" 优先生效
                                 #   (80-components 的 comp_default_on:有值则从 config.env 取)
DEPENDS_ON=""
EST_MEM_MI=150
READY_CHECK="deploy/external-secrets"

HELM_REPO="external-secrets https://charts.external-secrets.io"
HELM_CHART="external-secrets/external-secrets"
RELEASE=external-secrets

EXPOSE=none
