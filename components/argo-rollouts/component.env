# shellcheck shell=bash
ID=argo-rollouts
NAMESPACE=argo-rollouts
GROUP=infra
CONFIG_VAR=ADDON_ARGO_ROLLOUTS
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=80
READY_CHECK="deploy/argo-rollouts"

HELM_REPO="argo https://argoproj.github.io/argo-helm"
HELM_CHART="argo/argo-rollouts"
RELEASE=argo-rollouts

EXPOSE=none
