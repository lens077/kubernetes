# shellcheck shell=bash
ID=postgres
NAMESPACE=cnpg-system            # 算子的命名空间; 数据库实例另建在 postgresql
GROUP=infra
CONFIG_VAR=ADDON_CNPG
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=150
READY_CHECK="deploy/cnpg-cloudnative-pg"

HELM_REPO="cnpg https://cloudnative-pg.github.io/charts"
HELM_CHART="cnpg/cloudnative-pg"
RELEASE=cnpg

EXPOSE=tls-passthrough           # pg-main 就绪后自动应用 gateway/TLSRoute；TCPRoute 仅作兼容示例
HOSTNAME=pg.dev.test

# 依赖契约(2026-09-11): CNPG pg-main。机房集群 PG 定稿在 node3 外部实例, 本组件与
# _external/postgres-node3 同为 postgres 提供方, 由 config.env 的 CC_PROVIDERS 二选一
PROVIDES=postgres
SVC=pg-main-rw.postgresql.svc
PORT=5432
SCHEME=postgresql
CRED_SECRET=postgresql/pg-main-app       # CNPG 自建, 键 username/password(不是 ESO 物化)
CRED_KEYS="username password"
CA_REF=secret:postgresql/pg-main-ca:ca.crt   # 90 天自动续期, harvest 需重跑
VAULT_PATH=cnpg-main
