# shellcheck shell=bash
# =============================================================================
# vmauth —— VictoriaMetrics 公网入口的鉴权代理
#
# 与 opentelemetry 的 otlp/public 同一思路: 鉴权边界只在公网入口。
#   metrics.apikv.com → Pangolin → 网关 metrics.dev.test → vmauth:8427 → VM:8428
#   集群内(Grafana / vmalert / collector / otel-node)继续直连 vm-single...:8428, 不受影响。
# 公网只读: 程序用 bearer token, 浏览器打开 VMUI 用用户名密码。写入与 admin 接口一律 401,
# 公网写入统一走 otlp-dev.apikv.com(bearertokenauth)。
# =============================================================================
ID=vmauth
NAMESPACE=victoriametrics        # 与 VM 同 ns: 路由与后端 Service 同命名空间, 不需要 ReferenceGrant
GROUP=obs
CONFIG_VAR=ADDON_VMAUTH
DEFAULT_ENABLED=true
DEPENDS_ON="victoriametrics"
EST_MEM_MI=32
READY_CHECK="deploy/vmauth"

HELM_REPO=""                     # 单个无状态 Deployment, 用 manifests/ 直接装, 不依赖 chart 下载
HELM_CHART=""
RELEASE=vmauth
VMAUTH_IMAGE="victoriametrics/vmauth:v1.152.0"   # 与 vm-single 同版本

# 接管原先 victoriametrics 组件的公网路由(同名 HTTPRoute vm-single / vm-single-redirect 原地改后端)
EXPOSE=http
HOSTNAME=metrics.dev.test
REMOTE_HOST=metrics.apikv.com
REMOTE_SCHEME=https
REMOTE_CA=public

# 凭据(节点 creds, 只生成一次; Secret victoriametrics/vmauth-credentials):
#   vmauth-read-token   程序只读 bearer token(Gatus / control-tower 本地开发与 e2e)
#   vmauth-ui-password  浏览器 VMUI 用户 ops 的密码
CRED_SECRET=victoriametrics/vmauth-credentials
CRED_KEYS="read-token ui-password"
CRED_USER=ops
