# shellcheck shell=bash
ID=argo
NAMESPACE=argocd
GROUP=infra
CONFIG_VAR=ADDON_ARGOCD
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=500
READY_CHECK="deploy/argocd-server"

HELM_REPO=""                     # 官方 yaml manifest 安装(便于自定义; helm 方式已弃用)
HELM_CHART=""
RELEASE=argocd

EXPOSE=http
HOSTNAME=argocd.app.com
