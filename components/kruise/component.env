# shellcheck shell=bash
ID=kruise
NAMESPACE=kruise-system
GROUP=infra
CONFIG_VAR=ADDON_KRUISE
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=200
READY_CHECK="deploy/kruise-controller-manager"

HELM_REPO="openkruise https://openkruise.github.io/charts/"
HELM_CHART="openkruise/kruise"
RELEASE=kruise

EXPOSE=none
