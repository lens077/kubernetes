# host-watchdog 受管清单 —— node3 (193.112.22.183)
#
# 本文件只含「检查项定义」。NTFY_URL / NTFY_TOPIC / NTFY_TICKET_TOPIC /
# NTFY_TEST_TOPIC / NTFY_TOKEN / NTFY_PUBLISHER_USER 属于本地凭据与投递目标，
# 保留在主机 /etc/host-watchdog/watchdog.env，不入库、不被下发脚本覆盖。
#
# 变更流程：改本文件 → bash components/host-watchdog/install.sh node3 (先 dry-run 看差异)
#           → CONFIRM=yes bash components/host-watchdog/install.sh node3
#           → bash components/host-watchdog/verify.sh node3
# 下发只改受管行、备份原文件、不重启服务；下一次 5 分钟 timer 自然生效。
#
# 2026-11-12 边缘核心从 node1 全量迁至 node3，本清单随迁建立。
# node1 的 host-watchdog.timer 已 stop + disable（容器全部停服，留着只会持续误报）。

HOST_LABEL="node3"

# 24 个在跑的容器（Pangolin 四件套 + SafeLine 六件 + 认证数据三件 + 站点五件 + scorpius 三件）。
# 显式白名单：node3 上另有已停用/僵尸容器，全量扫描会产生常驻误报，
# 而常驻误报会让人忽略真告警。
# 2026-11-25: 从仓库清单移除 mcm-site（主机侧早已移除，公网站点 10-28 迁集群并改名 pyxis）。
WATCH="pangolin gerbil traefik crowdsec safeline-pg safeline-mgt safeline-detector safeline-luigi safeline-fvm safeline-chaos postgres casdoor webhook-webhook-1 ntfy-ntfy-1 redis-gorse apikv-site lyrapass-site homepage blog blog-reminder scorpius-license-scorpius-web-1 licensed"

SYSTEMD_UNITS="docker.service"

# 本机回环探测：与 Gatus 的公网探测互为对照，能区分「服务死了」和「入口断了」
HTTP_CHECKS="ntfy=http://10.1.4.10:8080/v1/health casdoor=http://127.0.0.1:8000/api/health"

# Pangolin 隧道站点在线检查
PANGOLIN_DB="/home/docker/pangolin/config/db/db.sqlite"
# mac=6 与 windows=19 为「已知长期离线」的站点：mac 是开发者本机、windows 是离线开发机，
# 属于覆盖盲区而非故障，按名称忽略，避免常驻误报淹没真告警。
PANGOLIN_IGNORE_SITES="mac Windows"

DISK_PATHS="/"
DISK_WARN_PCT=85
DISK_CRIT_PCT=95
HC_PING_URL=""
NOTIFY_HOLD_SECONDS=600
NOTIFY_RECOVER_SECONDS=300
