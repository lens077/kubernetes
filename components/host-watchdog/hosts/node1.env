# host-watchdog 受管清单 —— node1 (114.132.233.129)
#
# 本文件只含「检查项定义」。NTFY_URL / NTFY_TOPIC / NTFY_TICKET_TOPIC /
# NTFY_TEST_TOPIC / NTFY_TOKEN / NTFY_PUBLISHER_USER 属于本地凭据与投递目标，
# 保留在主机 /etc/host-watchdog/watchdog.env，不入库、不被下发脚本覆盖。
#
# 变更流程：改本文件 → bash components/host-watchdog/install.sh node1 (先 dry-run 看差异)
#           → CONFIRM=yes bash components/host-watchdog/install.sh node1
#           → bash components/host-watchdog/verify.sh node1
# 下发只改受管行、备份原文件、不重启服务；下一次 5 分钟 timer 自然生效。

HOST_LABEL="node1"

# 2026-11-25 退役：边缘核心已于 11-12 全量迁到 node3，node1 容器基本清空，
# host-watchdog.timer 早已 stop + disable。保留本清单文件只为记录退役状态，
# 所有检查项置空，避免 verify.sh 找不到清单，也避免任何误报复活。
# 历史条目（14 个）已用 retire-check.sh 从 incidents.json 清理。
WATCH=""

SYSTEMD_UNITS=""

HTTP_CHECKS=""

# Pangolin 隧道站点在线检查；siteId 8 = 已删除的 node0 站点，
# 其残留事件 pangolin:8 已于 2026-11-10 用 retire-check.sh 清理。
PANGOLIN_DB=""
PANGOLIN_IGNORE_SITES=mac

DISK_PATHS=""
DISK_WARN_PCT=85
DISK_CRIT_PCT=95
HC_PING_URL=""
NOTIFY_HOLD_SECONDS=600
NOTIFY_RECOVER_SECONDS=300
