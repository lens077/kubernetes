# host-watchdog 受管清单 —— node2 (8.138.194.254)
#
# 只含检查项定义；NTFY_* 凭据与 topic 保留在主机本地 /etc/host-watchdog/watchdog.env。
# 变更流程见 components/host-watchdog/README.md。

HOST_LABEL="node2"

# 2026-11-10 从 WATCH 移除 gorse-gorse-1：gorse 已于 2026-11-04 从 node2 docker
# 迁入集群 gorse 命名空间（三件套 master/server/worker），cache 用集群 Dragonfly
# 的 db0（RediSearch 索引只允许 db0），data 用 CNPG pg-main 的 gorse 库，
# 对外经 Cilium Gateway 暴露。node2 现在只剩 minio 一个业务容器。
# 原条目 docker:gorse-gorse-1 自 11-04 03:08 起按退避重发 9 轮，属纯误报；
# 集群侧已有 gatus/public-edge/gorse-edge-alert 承担现役监控，不留空档。
WATCH="minio"

SYSTEMD_UNITS="docker.service fail2ban.service"

# 2026-11-10 删除 gorse=http://127.0.0.1:8088/api/health/ready：
# 该端口随 gorse 迁走后无监听，探测恒为 000。现役 gorse API 是集群内
# gorse-server:8087，公网 Dashboard 302 到 /login。
HTTP_CHECKS="minio=https://minio.apikv.com:9000/minio/health/live|minio.apikv.com:9000:127.0.0.1|200,403"

PANGOLIN_DB=""
PANGOLIN_IGNORE_SITES=mac

DISK_PATHS="/"
DISK_WARN_PCT=85
DISK_CRIT_PCT=95
HC_PING_URL=""
NOTIFY_HOLD_SECONDS=600
NOTIFY_RECOVER_SECONDS=300
