# shellcheck shell=bash
ID=gatus
NAMESPACE=ops
GROUP=obs
CONFIG_VAR=ADDON_GATUS
DEFAULT_ENABLED=false
DEPENDS_ON=""                    # 探测目标装没装都能起; 没装的端点只是红着
EST_MEM_MI=64
READY_CHECK="deploy/gatus"

HELM_REPO=""                     # 单容器 + 一份 YAML, 自写 manifest(上游 chart 也只是包了一层 ConfigMap)
HELM_CHART=""
RELEASE=gatus

EXPOSE=http
HOSTNAME=status.dev.test
