# shellcheck shell=bash
ID=dragonflydb
NAMESPACE=dragonfly
GROUP=infra
CONFIG_VAR=ADDON_DRAGONFLY
DEFAULT_ENABLED=true
DEPENDS_ON="cert-manager"      # 2026-08-20 原生 TLS 化后必须先有 global-ca-issuer
EST_MEM_MI=512
READY_CHECK="deploy/dragonfly|statefulset/dragonfly"   # 单副本时 chart 建的是 Deployment

HELM_REPO=""                     # OCI chart, 不走 helm repo add
HELM_CHART="oci://ghcr.io/dragonflydb/dragonfly/helm/dragonfly"
RELEASE=dragonfly

EXPOSE=tcp                       # Redis 协议; 见 gateway/ 与 README「暴露方式」
HOSTNAME=redis.dev.test

# 依赖契约(2026-09-11): 缓存能力的唯一提供方(redis 组件已 ADDON_REDIS=false 退备)
PROVIDES=redis
SVC=dragonfly.dragonfly.svc      # Service 端口 6379 → 后端容器 6380 原生 TLS(README「原生 TLS」)
PORT=6379
SCHEME=rediss                    # 消费方据此填 tls.enable=true
DEV_PORT=6380                    # dev 经 dragonfly-gateway 的 TCP listener(gateway/tcproute.yaml)
CRED_SECRET=dragonfly/dragonfly-password-secret
CRED_KEYS="password"
CRED_USER=default
CA_REF=secret:cert-manager/global-root-ca-secret:ca.crt   # 证书由 global-ca-issuer 签发
VAULT_PATH=dragonfly
