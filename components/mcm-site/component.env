# shellcheck shell=bash
ID=mcm-site
NAMESPACE=sites
GROUP=sites
CONFIG_VAR=ADDON_MCM_SITE
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=32
READY_CHECK="deploy/mcm-site"

HELM_REPO=""                     # 官方 nginx + 内容打进镜像(2026-10-28 从 node1 docker 迁入)
HELM_CHART=""
RELEASE=mcm-site

EXPOSE=http
HOSTNAME=pyxis.apikv.com
MCM_IMAGE=ccr.ccs.tencentyun.com/sumery/mcm-site:v20261028
