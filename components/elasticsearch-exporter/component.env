# shellcheck shell=bash
ID=elasticsearch-exporter
NAMESPACE=elasticsearch
GROUP=obs
CONFIG_VAR=ADDON_ELASTICSEARCH_EXPORTER
DEFAULT_ENABLED=true
DEPENDS_ON=elasticsearch
EST_MEM_MI=64
READY_CHECK="deploy/elasticsearch-exporter"

HELM_REPO=""
HELM_CHART=""
RELEASE=elasticsearch-exporter

EXPOSE=none
