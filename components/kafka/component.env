# shellcheck shell=bash
ID=kafka
NAMESPACE=kafka
GROUP=infra
CONFIG_VAR=ADDON_STRIMZI
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=300
READY_CHECK="deploy/strimzi-cluster-operator"

HELM_REPO="strimzi https://strimzi.io/charts/"
HELM_CHART="strimzi/strimzi-kafka-operator"
RELEASE=strimzi

EXPOSE=none                      # 集群内 plain/tls listener 只有 ClusterIP; 对外走下面的 external listener
HOSTNAME=""

# 依赖契约(2026-09-23): 业务服务尚无 producer/consumer 接线, tools/config-center/mapping.yaml 也没有 kafka
# 能力, harvest 会「有提供方但映射表没有对应能力(跳过)」——这是预期, 不是错。等首个真实 Kafka
# 消费者出现时补 mapping, 这里的地址就直接可用。
PROVIDES=kafka
SVC=my-cluster-kafka-bootstrap.kafka.svc
PORT=9092                        # 集群内 plain(匿名), Kafka Connect 在用; tls 在 9093
SCHEME=kafka
CRED_SECRET=kafka/remote-dev     # KafkaUser remote-dev(cdc/kafka-remote-dev-user.yaml), 由 User Operator 生成
CRED_KEYS="password"
CRED_USER=remote-dev
CA_REF=secret:kafka/my-cluster-cluster-ca-cert:ca.crt   # Strimzi cluster CA, broker 证书由它签
# pangolin 策略: Pangolin raw TCP 资源 kafka-dev(resourceId 61, proxyPort 30004) → site k8s-cluster newt
# → Cilium Gateway 10.10.31.243:9094(cdc/kafka-external-gateway.yaml) → external listener(SASL_SSL, SCRAM-SHA-512)。
# advertised.listeners 就是 REMOTE_HOST:REMOTE_PORT——Kafka 客户端第二跳按 metadata 连 broker, 写别的都会断。
# 2026-09-23 实测: 公网 produce→consume 往返、错密码 Authentication failed。
REMOTE_HOST=kafka-dev.apikv.com
REMOTE_PORT=30004
REMOTE_SCHEME=kafka+sasl_ssl
REMOTE_CA=private                # 直通: 客户端看到 Strimzi cluster CA 签的 broker 证书, 带 ca_pem
