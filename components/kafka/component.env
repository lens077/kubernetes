# shellcheck shell=bash
ID=kafka
NAMESPACE=kafka
GROUP=infra
CONFIG_VAR=ADDON_STRIMZI
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=300
READY_CHECK="deploy/strimzi-cluster-operator"

HELM_REPO="strimzi https://strimzi.io/charts/"
HELM_CHART="strimzi/strimzi-kafka-operator"
RELEASE=strimzi

EXPOSE=loadbalancer              # 不走 Gateway: Strimzi 要向客户端播 advertised address
HOSTNAME=""
