# shellcheck shell=bash
ID=victoria-logs
NAMESPACE=logging
GROUP=obs
CONFIG_VAR=ADDON_VICTORIA_LOGS
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=300
READY_CHECK="statefulset/vl-victoria-logs-single-server"

HELM_REPO="vm https://victoriametrics.github.io/helm-charts/"
HELM_CHART="vm/victoria-logs-single"
RELEASE=vl

EXPOSE=none
