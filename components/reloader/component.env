# shellcheck shell=bash
ID=reloader
NAMESPACE=reloader
GROUP=infra
CONFIG_VAR=ADDON_RELOADER
DEFAULT_ENABLED=false            # 只在「Secret 会在脚本之外变化」时才有意义, 见 README §1
DEPENDS_ON="external-secrets"    # 它只是 ESO 物化链路的最后一环: Vault/OpenBao → ESO → Secret → Reloader 滚动
EST_MEM_MI=64                    # 上游默认无 requests; values.yaml 钉 32Mi/128Mi, 单副本
READY_CHECK="deploy/reloader-reloader"   # chart fullname = <release>-reloader

HELM_REPO="stakater https://stakater.github.io/stakater-charts"
HELM_CHART="stakater/reloader"
RELEASE=reloader

EXPOSE=none                      # 纯控制器, 只有 :9090 指标口, 不对外
