# shellcheck shell=bash
ID=fluent-bit
NAMESPACE=logging
GROUP=obs
CONFIG_VAR=ADDON_FLUENT_BIT
DEFAULT_ENABLED=true
DEPENDS_ON="loki"
EST_MEM_MI=128
READY_CHECK="daemonset/fluent-bit"

HELM_REPO="fluent https://fluent.github.io/helm-charts"
HELM_CHART="fluent/fluent-bit"
RELEASE=fluent-bit

EXPOSE=none                      # 只在集群内把容器日志写入 Loki
HOSTNAME=""
