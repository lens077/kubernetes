# shellcheck shell=bash
ID=redis
NAMESPACE=redis
GROUP=infra
CONFIG_VAR=ADDON_REDIS
DEFAULT_ENABLED=false            # 技术验证组件: 缓存主力是 dragonflydb, 见 README「定位」
DEPENDS_ON="cert-manager"        # 原生 TLS 证书由 global-ca-issuer 签
EST_MEM_MI=300
READY_CHECK="statefulset/redis"

HELM_REPO=""                     # OCI chart, 不走 helm repo add
HELM_CHART="oci://registry-1.docker.io/cloudpirates/redis"
RELEASE=redis

EXPOSE=tcp                       # Redis 原生 TLS over TCPRoute(6380); 见 gateway/ 与 README
HOSTNAME=redis-oss.dev.test      # redis.dev.test 已被 dragonflydb 占用(展示/证书 SAN 用)
