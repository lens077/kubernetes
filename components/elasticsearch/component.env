ID=elasticsearch
NAMESPACE=elasticsearch
GROUP=data
CONFIG_VAR=ADDON_ELASTICSEARCH
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=1536
READY_CHECK="statefulset/elasticsearch"
EXPOSE=http
HOSTNAME=es.dev.test              # gateway/httproute.yaml; Pangolin es-dev.apikv.com 的 tlsServerName/Host
RELEASE=elasticsearch

# 依赖契约(2026-09-23): search 服务的 search.catalog(只读 alias ecommerce_catalog_products)。
# CRED_SECRET 里是只读 API key(角色 ecommerce-search-read: 只读 ecommerce_catalog_products* + cluster monitor),
# 由 install.sh 幂等创建; 不是 elastic 超级用户。
PROVIDES=elasticsearch
SVC=elasticsearch.elasticsearch.svc
PORT=9200
SCHEME=http
DEV_PORT=443
DEV_SCHEME=https
CRED_SECRET=elasticsearch/search-api-key
CRED_KEYS="api_key"
# pangolin 策略: Pangolin HTTP 资源 es-dev(SSO 关, tlsServerName/Host=es.dev.test) → site k8s-cluster → VIP:443。
REMOTE_HOST=es-dev.apikv.com
REMOTE_PORT=443
REMOTE_SCHEME=https
REMOTE_CA=public                 # Traefik 终止 TLS(公共泛证书), ca_pem 留空
