# shellcheck shell=bash
ID=bugsink
NAMESPACE=ops
GROUP=obs
CONFIG_VAR=ADDON_BUGSINK
DEFAULT_ENABLED=false
DEPENDS_ON="alert-bridge"        # issue 通知经告警桥推 ntfy; 桥的 token 装进 bugsink 的 webhook 白名单说明
EST_MEM_MI=512
READY_CHECK="deploy/bugsink"

HELM_REPO=""                     # 官方镜像 + sqlite(WAL), 自写 manifest
HELM_CHART=""
RELEASE=bugsink

EXPOSE=http
HOSTNAME=bugsink.dev.test
