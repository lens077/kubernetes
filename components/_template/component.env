# shellcheck shell=bash
# =============================================================================
# 组件元数据 —— bootstrap/scripts/80-components.sh 扫描它来组装安装菜单
# 只放"编排器需要知道的事", 具体怎么装写在同目录的 install.sh 里
# =============================================================================

ID=example                       # 组件 id(= 目录名)
NAMESPACE=example                # 安装到的命名空间
GROUP=infra                      # 菜单分组: base(基础) | obs(可观测性) | infra(基础设施)
CONFIG_VAR=""                    # config.env 里对应的开关变量名(如 ADDON_VM);
                                 #   显式声明, 不靠"目录名转大写"猜(历史命名并不一致)
DEFAULT_ENABLED=false            # CONFIG_VAR 未定义时的兜底开关
DEPENDS_ON=""                    # 空格分隔的组件 id; 编排器据此拓扑排序(例: "cert-manager")
EST_MEM_MI=100                   # 预估内存占用, 用于菜单里的总量提示
READY_CHECK=""                   # 就绪判据, 传给 kubectl rollout status;
                                 #   多候选用 | 分隔依次尝试(例: "statefulset/loki|deploy/loki")

# helm 优先。用 yaml manifest 安装的组件(如 jaeger/argo)留空, 在 install.sh 里自己处理。
HELM_REPO=""                     # 形如 "vm https://victoriametrics.github.io/helm-charts/"
HELM_CHART=""                    # 形如 "vm/victoria-metrics-single" 或 oci:// 地址
RELEASE=""                       # helm release 名, 留空则用 ID

# 对外暴露方式: none | http | grpc | tls-passthrough | tcp | loadbalancer
# http/grpc 走共享网关 default/cilium-gateway; tls-passthrough/tcp 需要独立 Gateway(见 gateway/)
EXPOSE=none
HOSTNAME=""                      # 留空则取 <ID>.$CLUSTER_DOMAIN

# ---------------------------------------------------------------------------
# 依赖契约(2026-09-11): 组件作为别人的依赖时「我是谁、地址、端口、凭据在哪」的声明。
# 消费方(tools/config-center-harvest.sh)只认这些字段, 不猜。没有 PROVIDES 的组件不参与。
# 声明优先、发现校验: 80 阶段 verify_contracts 会核对 Service/端口/Secret 真实存在。
# ---------------------------------------------------------------------------
PROVIDES=""                      # 能力名(redis | postgres | consul | otlp | casdoor | elasticsearch ...)
                                 #   同一集群同一能力只能有一个启用的提供方; 冲突时 config.env 的
                                 #   CC_PROVIDERS="<能力>=<组件id> ..." 指定
SVC=""                           # pre 策略(集群内消费方)用的地址: <svc>.<ns>.svc; 外部实例写域名/IP
PORT=""                          # 同上端口
SCHEME=""                        # 协议提示, 消费方据此填 tls.enable 等: rediss | redis | postgresql | http | https | grpc
DEV_PORT=""                      # dev 策略(本机/内网消费方经 Gateway)端口, 留空同 PORT; 地址用 HOSTNAME
DEV_SCHEME=""                    # 同上协议, 留空同 SCHEME
CRED_SECRET=""                   # 凭据所在 Secret: <ns>/<name>; 由 ESO 从 Vault/OpenBao 物化(P1 之后)
CRED_KEYS=""                     # 该 Secret 里哪些键是凭据, 空格分隔(例 "password" / "user password")
CRED_USER=""                     # 非机密的固定用户名(有的话)
CA_REF=""                        # 证书链来源: secret:<ns>/<name>:<key> 或 configmap:<ns>/<name>:<key>
VAULT_PATH=""                    # Vault/OpenBao KV 路径的组件段, 留空同 ID; 完整路径 = k8s/$CLUSTER_NAME/<此值>
EXTERNAL=false                   # true = 集群外实例(components/_external/*), 不装、只声明、不查 Service
REMOTE_HOST=""                   # pangolin 策略(开发机不在集群 LAN, 经 Pangolin 资源访问)的地址; 留空 = 该组件没有远程入口
REMOTE_PORT=""                   #   HTTP 组件: Pangolin HTTP 资源(443, 关 SSO, setHostHeader=HOSTNAME); TCP 组件: raw TCP 资源端口(TLS 直通)
REMOTE_SCHEME=""                 #   https | rediss | ...
REMOTE_CA="public"               #   public = Traefik 终止 TLS(公共证书, ca_pem 留空); private = TLS 直通到组件自己的证书(带 ca_pem, 证书 SAN 须含 REMOTE_HOST)
