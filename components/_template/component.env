# shellcheck shell=bash
# =============================================================================
# 组件元数据 —— bootstrap/scripts/80-components.sh 扫描它来组装安装菜单
# 只放"编排器需要知道的事", 具体怎么装写在同目录的 install.sh 里
# =============================================================================

ID=example                       # 组件 id(= 目录名)
NAMESPACE=example                # 安装到的命名空间
GROUP=infra                      # 菜单分组: base(基础) | obs(可观测性) | infra(基础设施)
CONFIG_VAR=""                    # config.env 里对应的开关变量名(如 ADDON_VM);
                                 #   显式声明, 不靠"目录名转大写"猜(历史命名并不一致)
DEFAULT_ENABLED=false            # CONFIG_VAR 未定义时的兜底开关
DEPENDS_ON=""                    # 空格分隔的组件 id; 编排器据此拓扑排序(例: "cert-manager")
EST_MEM_MI=100                   # 预估内存占用, 用于菜单里的总量提示
READY_CHECK=""                   # 就绪判据, 传给 kubectl rollout status;
                                 #   多候选用 | 分隔依次尝试(例: "statefulset/loki|deploy/loki")

# helm 优先。用 yaml manifest 安装的组件(如 jaeger/argo)留空, 在 install.sh 里自己处理。
HELM_REPO=""                     # 形如 "vm https://victoriametrics.github.io/helm-charts/"
HELM_CHART=""                    # 形如 "vm/victoria-metrics-single" 或 oci:// 地址
RELEASE=""                       # helm release 名, 留空则用 ID

# 对外暴露方式: none | http | grpc | tls-passthrough | tcp | loadbalancer
# http/grpc 走共享网关 default/cilium-gateway; tls-passthrough/tcp 需要独立 Gateway(见 gateway/)
EXPOSE=none
HOSTNAME=""                      # 留空则取 <ID>.$CLUSTER_DOMAIN
