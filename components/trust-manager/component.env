# shellcheck shell=bash
ID=trust-manager
NAMESPACE=trust-system
GROUP=infra
CONFIG_VAR=ADDON_TRUST_MANAGER
DEFAULT_ENABLED=false
DEPENDS_ON="cert-manager"
EST_MEM_MI=70
READY_CHECK="deploy/trust-manager"

HELM_REPO="jetstack https://charts.jetstack.io"
HELM_CHART="jetstack/trust-manager"
RELEASE=trust-manager

EXPOSE=none
