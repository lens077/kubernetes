# shellcheck shell=bash
ID=tempo
NAMESPACE=tempo
GROUP=obs
CONFIG_VAR=ADDON_TEMPO
DEFAULT_ENABLED=false            # 评估期: jaeger 仍是主 trace 后端, 见 README「定位」
DEPENDS_ON=""
EST_MEM_MI=600
READY_CHECK="statefulset/tempo"

HELM_REPO="grafana-community https://grafana-community.github.io/helm-charts"
HELM_CHART="grafana-community/tempo"
RELEASE=tempo

EXPOSE=http                      # 3200 查询 API 走共享网关; OTLP 4317/4318 仅集群内
HOSTNAME=tempo.dev.test
