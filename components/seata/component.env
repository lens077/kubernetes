# shellcheck shell=bash
ID=seata
NAMESPACE=seata
GROUP=infra
CONFIG_VAR=ADDON_SEATA
DEFAULT_ENABLED=false            # 技术验证组件: ecommerce 的一致性走 Outbox+Saga, 见 README
DEPENDS_ON=""                    # store.mode=file 无外部依赖; 换 db 模式则依赖 postgres
EST_MEM_MI=768
READY_CHECK="statefulset/seata-server"

HELM_REPO=""                     # 官方 chart 事实弃养(apiVersion v1/appVersion "1.0"), 用自写清单
HELM_CHART=""
RELEASE=seata

EXPOSE=tcp                       # 8091 是 Netty 私有协议, 不是 HTTP —— 见 gateway/ 与 README
HOSTNAME=seata.dev.test          # 仅作展示; TCPRoute 无 hostname 概念
