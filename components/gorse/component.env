# shellcheck shell=bash
ID=gorse
NAMESPACE=gorse
GROUP=infra
CONFIG_VAR=ADDON_GORSE
DEFAULT_ENABLED=true
DEPENDS_ON="dragonfly postgres argo"
EST_MEM_MI=512
READY_CHECK="deployment/gorse"
RELEASE=gorse
EXPOSE=http
HOSTNAME=gorse.apikv.com         # Pangolin 资源 gorse(rid 17) → k8s-cluster VIP，经本组件 HTTPRoute
SVC=gorse.gorse.svc
PORT=8088
SCHEME=http

# 数据/缓存契约（.service-matrix.yaml 的 gorse / redis_gorse / postgres_gorse 迁移后口径）
CACHE_SVC=dragonfly.dragonfly.svc  # Dragonfly TLS+AUTH，gorse 独占逻辑 DB 2
CACHE_DB_INDEX=0
PG_RW=pg-main-rw.postgresql.svc    # CNPG pg-main，database=gorse, user=gorse
PG_DB=gorse

# GitOps（ArgoCD 跟踪本仓，chart 即 ./chart）
ARGO_APP=gorse
ARGO_REPO_URL=https://github.com/lens077/kubernetes.git
ARGO_TARGET_REVISION=main
ARGO_PATH=components/gorse/chart

CRED_SECRET=gorse/gorse-store     # api-key/admin-api-key/cache-store/data-store（install.sh 现取物化）
CRED_KEYS="api-key admin-api-key cache-store data-store"
