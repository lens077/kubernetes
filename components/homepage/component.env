# shellcheck shell=bash
ID=homepage
NAMESPACE=sites
GROUP=sites
CONFIG_VAR=ADDON_HOMEPAGE
DEFAULT_ENABLED=false
DEPENDS_ON="vmauth"              # /t/*.json 遥测只读代理回源 vmauth(read token)
EST_MEM_MI=32
READY_CHECK="deploy/homepage"

HELM_REPO=""                     # 官方 nginx + 站点与模板打进镜像(2026-10-28 从 node1 docker 迁入)
HELM_CHART=""
RELEASE=homepage

EXPOSE=http
HOSTNAME=d.apikv.com
HOMEPAGE_IMAGE=ccr.ccs.tencentyun.com/sumery/homepage:v20261028
