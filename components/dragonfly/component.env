# shellcheck shell=bash
ID=dragonfly
NAMESPACE=dragonfly
GROUP=infra
CONFIG_VAR=ADDON_DRAGONFLY
DEFAULT_ENABLED=true
DEPENDS_ON="cert-manager"
EST_MEM_MI=512
READY_CHECK="statefulset/dragonfly"
HELM_REPO=""
HELM_CHART=""
RELEASE=dragonfly
EXPOSE=tcp                       # Redis 协议; dragonfly-gateway TCP listener 10.10.31.242:6379(manifests/01-tcp-route.yaml)
HOSTNAME=dragonfly.dev.test      # 证书 SAN(manifests/00-certificate.yaml)

# 依赖契约: 缓存能力的唯一提供方(旧 components/dragonflydb 是 2026-09-22 集群重建前的形态, 已由本组件取代)
PROVIDES=redis
SVC=dragonfly.dragonfly.svc
PORT=6379
SCHEME=rediss                    # 原生 TLS, 消费方据此填 tls.enable=true
DEV_PORT=6379                    # gateway 策略: 机房 LAN 开发机直连 VIP 10.10.31.242:6379
CRED_SECRET=dragonfly/dragonfly-auth   # ESO 从 OpenBao k8s/<集群>/dragonfly 物化(externalsecret.yaml)
CRED_KEYS="password"
CRED_USER=default
CA_REF=secret:cert-manager/global-root-ca-secret:ca.crt   # 证书由 global-ca-issuer 签发
VAULT_PATH=dragonfly
# pangolin 策略(开发机不在机房 LAN): Pangolin raw TCP 资源 redis-dev(resourceId 59, proxyPort 30005)
# → site k8s-cluster newt → 10.10.31.242:6379, TLS 直通。2026-09-22 Mac 实测: CA 校验 + SNI + AUTH 正反向通过。
REMOTE_HOST=redis-dev.apikv.com
REMOTE_PORT=30005
REMOTE_SCHEME=rediss
REMOTE_CA=private                # 直通: 客户端看到的是 Dragonfly 自己的证书(global-root-ca 签), 带 ca_pem; SAN 含 REMOTE_HOST
