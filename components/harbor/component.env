# shellcheck shell=bash
ID=harbor
NAMESPACE=harbor
GROUP=infra
CONFIG_VAR=ADDON_HARBOR
DEFAULT_ENABLED=false
DEPENDS_ON="cert-manager"
EST_MEM_MI=1216      # 2026-09-17 关掉 Trivy 后重算(原 1728 含 trivy 的 512Mi requests)
READY_CHECK="deployment/harbor-core"

HELM_REPO="harbor https://helm.goharbor.io"
HELM_CHART="harbor/harbor"
RELEASE=harbor

EXPOSE=http
HOSTNAME=harbor.dev.test   # 机房 LAN split DNS;公网入口(harbor.apikv.com)当前指向 node2 的 docker 版,未切
