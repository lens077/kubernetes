# shellcheck shell=bash
ID=victoriametrics
NAMESPACE=victoriametrics
GROUP=obs
CONFIG_VAR=ADDON_VM
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=500
READY_CHECK="statefulset/vm-single-victoria-metrics-single-server|deploy/vm-single-victoria-metrics-single-server"

HELM_REPO="vm https://victoriametrics.github.io/helm-charts/"
HELM_CHART="vm/victoria-metrics-single"
RELEASE=vm-single

# 2026-09-29: 公网/网关入口移交 components/vmauth(只读鉴权代理), 本组件不再有 gateway/。
# 集群内消费方继续直连 vm-single-victoria-metrics-single-server:8428。
EXPOSE=none
