# shellcheck shell=bash
# node3 上的 otelcol-contrib(尾采样/PII 脱敏), 经 Pangolin https 443 暴露 —— 集群外, 只声明。
# 现网 10 份 pre bootstrap 的 observability.{trace,metric,log}.endpoint 都指向它。
ID=otlp-node3
NAMESPACE=external
GROUP=obs
CONFIG_VAR=EXTERNAL_OTLP_NODE3
DEFAULT_ENABLED=true
EXTERNAL=true

PROVIDES=otlp
SVC=node3-otlp.apikv.com
PORT=443
SCHEME=https                     # 消费方填 tls.enable=true; 入口是公共可信泛证书, 不需要 ca_pem(现网为空, 2026-09-11 核对)
VAULT_PATH=otlp-node3            # 无凭据、无 CA: 目前 OpenBao 里不需要这条路径
