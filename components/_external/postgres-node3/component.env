# shellcheck shell=bash
# ⚠️ 已退役(2026-09-22): 旧 node3 主机已重装为 k3, Pigsty 与 pg-meta 不再存在。
#    业务库现为集群内 CNPG pg-main(pg-main-rw.postgresql.svc:5432); CC_PROVIDERS 已指定 postgres=postgres。
#    角色/授权参考见 backup/pigsty-node3-20260921/postgres/(只是权限参考, 不是业务数据备份)。
# node3 Pigsty PostgreSQL(pg-meta, Patroni 单实例) —— 集群外, 只声明不安装。
# 通路: 集群内外都只能经 node1 Pangolin 的 raw 口 30001(control-tower service-interconnect.md);
# 证书由 Pigsty 自签 CA 签发, SAN 含 pg.apikv.com 与入口 IP(2026-08-30 补签)。
ID=postgres-node3
NAMESPACE=external               # 凭据/CA 由 ESO 物化到这个 ns(P1: externalsecret.yaml)
GROUP=infra
CONFIG_VAR=EXTERNAL_PG_NODE3
DEFAULT_ENABLED=false            # 2026-09-23: 退役, 默认关; 见文件顶部
EXTERNAL=true

PROVIDES=postgres
SVC=pg.apikv.com                 # 现网 pre bootstrap 写的是入口 IP 114.132.233.129; 域名/IP 两条路径都可 verify-full
PORT=30001
SCHEME=postgresql
CRED_SECRET=external/postgres-node3
CRED_KEYS="user password"
CA_REF=secret:external/postgres-node3:ca.crt
VAULT_PATH=postgres-node3        # k8s/<集群>/postgres-node3: user / password / ca.crt(手工放入一次, Pigsty 侧是真相)
