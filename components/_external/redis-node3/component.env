# shellcheck shell=bash
# node3 Redis 主从 + stunnel TLS 终止(Pigsty), 经 node1 Pangolin raw 口 30002 —— 集群外, 只声明。
# 消费方: control-tower config 服务自身(config-center-bootstrap; 见 mapping.yaml consumers)。
# ecommerce 业务服务的缓存是集群内 dragonflydb, 全局 redis 提供方由 config.env CC_PROVIDERS 指定为 dragonflydb。
ID=redis-node3
NAMESPACE=external
GROUP=infra
CONFIG_VAR=EXTERNAL_REDIS_NODE3
DEFAULT_ENABLED=true
EXTERNAL=true

PROVIDES=redis
SVC=redis.apikv.com
PORT=30002
SCHEME=rediss
CRED_SECRET=external/redis-node3
CRED_KEYS="password"
CRED_USER=default
CA_REF=secret:external/redis-node3:ca.crt   # Pigsty 自签 CA(与 postgres-node3 同源)
VAULT_PATH=redis-node3
