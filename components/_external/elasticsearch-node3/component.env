# shellcheck shell=bash
# ⚠️ 已退役(2026-09-22): 旧 node3 主机已重装为 k3, 这个外部 ES 端点不再存在。
#    搜索投影现由集群内 components/elasticsearch 承载(9.4.5 + IK, elasticsearch.elasticsearch.svc:9200)。
#    保留本声明只为记录历史契约; EXTERNAL_ES_NODE3 已固定为 false, 不要重新打开。
# node3 Elasticsearch 9.x + IK(搜索只读投影, ecommerce TECH-RADAR §2) —— 集群外, 只声明。
# 只有 search 服务消费(schema 的 search.catalog); 经受控入口访问。
ID=elasticsearch-node3
NAMESPACE=external
GROUP=infra
CONFIG_VAR=EXTERNAL_ES_NODE3
DEFAULT_ENABLED=false            # 2026-09-23: 退役, 默认关; 见文件顶部
EXTERNAL=true

PROVIDES=elasticsearch
SVC=es.apikv.com                 # 现网 search/pre/bootstrap.yaml 的 search.catalog.endpoint = https://es.apikv.com(2026-09-11 核对)
PORT=443
SCHEME=https
CRED_SECRET=external/elasticsearch-node3
CRED_KEYS="api_key"              # 现网只用 api_key; username/password 留空
VAULT_PATH=elasticsearch-node3
