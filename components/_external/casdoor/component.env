# shellcheck shell=bash
# Casdoor IdP(云箱, 收编进集群是 TECH-RADAR §4 附的既定方向但未落地) —— 集群外, 只声明。
# client_id/organization/application 是非机密固定值, 写在 overrides; client_secret/certificate 从 Vault 来。
ID=casdoor
NAMESPACE=external
GROUP=infra
CONFIG_VAR=EXTERNAL_CASDOOR
DEFAULT_ENABLED=true
EXTERNAL=true

PROVIDES=casdoor
SVC=casdoor.apikv.com
PORT=443
SCHEME=https
CRED_SECRET=external/casdoor
CRED_KEYS="client_secret certificate"
VAULT_PATH=casdoor
