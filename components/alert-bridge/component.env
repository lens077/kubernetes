# shellcheck shell=bash
ID=alert-bridge
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_ALERT_BRIDGE
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=32
READY_CHECK="deploy/alert-bridge"

HELM_REPO=""                     # 171 行标准库 python, 自写 manifest(脚本进 ConfigMap, 不需要构建镜像)
HELM_CHART=""
RELEASE=alert-bridge

EXPOSE=none                      # 只被 Alertmanager / Bugsink 从集群内调用
