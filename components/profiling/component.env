# shellcheck shell=bash
# 持续剖析(continuous profiling): Pyroscope v2 server + Grafana Alloy eBPF 无侵入采集。
ID=profiling
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_PROFILING
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=1536
READY_CHECK="statefulset/pyroscope|daemonset/alloy-pyroscope"

HELM_REPO=""
HELM_CHART=""
RELEASE=profiling

# 不对外暴露: 只供集群内 Grafana(uid ds-pyroscope) 与 Service 消费。
EXPOSE=none
HOSTNAME=""

# 依赖契约: Grafana 数据源按约定连 pyroscope.observability.svc:4040。
PROVIDES=profiling
SVC=pyroscope.observability.svc.cluster.local
PORT=4040
SCHEME=http
DEV_PORT=""
DEV_SCHEME=""
