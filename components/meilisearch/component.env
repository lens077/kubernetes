# shellcheck shell=bash
ID=meilisearch
NAMESPACE=search
GROUP=infra
CONFIG_VAR=ADDON_MEILISEARCH
DEFAULT_ENABLED=true
DEPENDS_ON=""
EST_MEM_MI=400
READY_CHECK="statefulset/meilisearch|deploy/meilisearch"

HELM_REPO="meilisearch https://meilisearch.github.io/meilisearch-kubernetes"
HELM_CHART="meilisearch/meilisearch"
RELEASE=meilisearch

EXPOSE=http
HOSTNAME=search.app.com
