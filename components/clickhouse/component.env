# shellcheck shell=bash
ID=clickhouse
NAMESPACE=clickhouse
GROUP=infra
CONFIG_VAR=ADDON_CLICKHOUSE
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=1100
READY_CHECK="statefulset/clickhouse"

# 刻意不用 helm: 单节点场景 Altinity operator 是多余控制面,
# Bitnami chart 2025-08 后免费镜像进 legacy 线不再维护 —— 官方镜像 + 受控 StatefulSet
HELM_REPO=""
HELM_CHART=""
RELEASE=clickhouse

EXPOSE=none
