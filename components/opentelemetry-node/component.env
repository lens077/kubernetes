# shellcheck shell=bash
# =============================================================================
# OpenTelemetry Node Agent —— 每节点一份，只采主机指标（hostmetrics）
#
# 为什么要与 opentelemetry 组件分开：主机指标必须从**每个节点**采，而那份是
# 单副本 Deployment，装 hostmetrics 只会拿到它自己所在 Pod 的视角，读出来的
# CPU/内存/磁盘既不是节点的，也只有一个节点的。DaemonSet 是唯一正确形态。
# 两者共用同一个远端出口，互不接收对方的信号。
# =============================================================================
ID=opentelemetry-node
NAMESPACE=opentelemetry
GROUP=obs
CONFIG_VAR=ADDON_OTEL_NODE
DEFAULT_ENABLED=true
DEPENDS_ON="opentelemetry"   # 只为排序：共用同一个 ns 与远端出口
EST_MEM_MI=64
READY_CHECK="daemonset/otel-node-opentelemetry-collector-agent"

HELM_REPO="open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts"
HELM_CHART="open-telemetry/opentelemetry-collector"
CHART_VERSION="0.171.0"          # 与 opentelemetry 组件同版本，避免两份 collector 行为漂移
RELEASE=otel-node

EXPOSE=none                      # 只出不进：不接收任何 OTLP

# 与 opentelemetry 组件写同一个远端入口。
# ⚠️ 只能用 http：该资源在 Pangolin 上没配 TLS，https://metrics.apikv.com 返回 404。
REMOTE_METRICS_URL="http://metrics.apikv.com/opentelemetry/v1/metrics"
