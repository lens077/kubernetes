# shellcheck shell=bash
ID=victoria-traces
NAMESPACE=observability
GROUP=obs
CONFIG_VAR=ADDON_VICTORIA_TRACES
DEFAULT_ENABLED=false
DEPENDS_ON=""
EST_MEM_MI=300
READY_CHECK="statefulset/victoria-traces"

HELM_REPO="vm https://victoriametrics.github.io/helm-charts/"
HELM_CHART="vm/victoria-traces-single"
CHART_VERSION="0.1.11"           # app v0.11.0(2026-08-17); 固定版本便于复现与回滚
RELEASE=vt

EXPOSE=http                      # vmui(/select/vmui) 与 Jaeger 兼容查询 API 经共享网关
HOSTNAME=traces.dev.test
