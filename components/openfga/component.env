# shellcheck shell=bash
ID=openfga
NAMESPACE=openfga
GROUP=infra
CONFIG_VAR=ADDON_OPENFGA
DEFAULT_ENABLED=false
DEPENDS_ON="postgres"          # CNPG 算子组件的实际 id 是 postgres(2026-08-20 修正, 原写 cnpg 不存在)
EST_MEM_MI=300
READY_CHECK="deploy/openfga"

HELM_REPO="openfga https://openfga.github.io/helm-charts"
HELM_CHART="openfga/openfga"
RELEASE=openfga

EXPOSE=none
