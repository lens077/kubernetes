# shellcheck shell=bash
ID=newt
NAMESPACE=pangolin
GROUP=infra
CONFIG_VAR=ADDON_NEWT
DEFAULT_ENABLED=false            # 需要先在 Pangolin 面板建站点拿到凭据, 见 README
                                 # 2026-09-22 实测更正: 旧 node3/node4/node5 三个 site 的记录在 Pangolin
                                 #   里仍然存在, 只是 online=0(客户端随主机重装消失), 不是"已失效"。
                                 #   但 secret 只在建站那一刻回显一次、面板 API 事后取不回, 所以仍然只能
                                 #   新建 site 拿新凭据(现为 site 11 k8s-cluster)。旧 site 7/9/10 已在资源迁完后删除(2026-09-22)。
DEPENDS_ON=""
EST_MEM_MI=64
READY_CHECK="deploy/newt"

HELM_REPO=""                     # 上游没有可用的 chart 仓库(fosrl.github.io/newt 实测 404),
HELM_CHART=""                    #   用自写 manifest —— 它本来就只是一个容器
RELEASE=newt

EXPOSE=none                      # 纯出站隧道: 不监听任何端口, 也不需要集群侧开任何入口
