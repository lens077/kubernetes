# shellcheck shell=bash
ID=newt
NAMESPACE=pangolin
GROUP=infra
CONFIG_VAR=ADDON_NEWT
DEFAULT_ENABLED=false            # 需要先在 Pangolin 面板建站点拿到凭据, 见 README
                                 # 2026-09-22: 旧 node3/node4/node5 三个 newt site 已随主机重装失效,
                                 #   必须新建一个集群 site, 不要复用旧 site 的 id/secret
DEPENDS_ON=""
EST_MEM_MI=64
READY_CHECK="deploy/newt"

HELM_REPO=""                     # 上游没有可用的 chart 仓库(fosrl.github.io/newt 实测 404),
HELM_CHART=""                    #   用自写 manifest —— 它本来就只是一个容器
RELEASE=newt

EXPOSE=none                      # 纯出站隧道: 不监听任何端口, 也不需要集群侧开任何入口
