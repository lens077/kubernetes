# shellcheck shell=bash
ID=umami
NAMESPACE=ops
GROUP=obs
CONFIG_VAR=ADDON_UMAMI
DEFAULT_ENABLED=false
DEPENDS_ON="postgres"            # 2026-09-22 起用集群内 CNPG pg-main(UMAMI_DB_ENDPOINT), 旧 node3 Pigsty 已退役
EST_MEM_MI=512
READY_CHECK="deploy/umami"

HELM_REPO=""                     # 官方镜像 + 自写 manifest(上游 chart 只覆盖自带 PG 的形态)
HELM_CHART=""
RELEASE=umami

EXPOSE=http
HOSTNAME=umami.apikv.com
