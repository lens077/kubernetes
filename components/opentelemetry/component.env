# shellcheck shell=bash
ID=opentelemetry
NAMESPACE=opentelemetry
GROUP=obs
CONFIG_VAR=ADDON_OTEL
DEFAULT_ENABLED=true
DEPENDS_ON=""   # 三条 pipeline 直写 node3；不再依赖集群内 VM/Loki/Jaeger
EST_MEM_MI=200
READY_CHECK="deploy/otel-opentelemetry-collector"

HELM_REPO="open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts"
HELM_CHART="open-telemetry/opentelemetry-collector"
CHART_VERSION="0.171.0"          # collector 0.158.0；固定版本便于复现与回滚
RELEASE=otel

EXPOSE=none                      # OTLP 只在集群内; 要给集群外用见 jaeger/examples/otlp-grpcroute.yaml

# 2026-08-24: 三条信号改推 node3(Pigsty)的 Victoria 全家桶, 经 node1 的 Pangolin 公网入口,
# 目的是把观测存储负载挪出家里内网。设了这三个就**不再写集群内的 VM/Loki/Jaeger** ——
# 双写等于内网还要多扛一份, 与目的相反。切回本地: 注释掉这三行重跑 install.sh。
# 路径里的 /insert 前缀不能省, 原因见 install.sh 顶部说明。
# 2026-08-29: node3-metrics.apikv.com 已改名为 metrics.apikv.com。改名当时没同步这里,
# collector 对旧域名拿到 404 并持续 "Exporting failed. Dropping data."(单批丢上千条),
# 而 logs/traces 两条没改名、不受影响。
# ⚠️ 只能用 http:新资源在 Pangolin 上没配 TLS,https://metrics.apikv.com 返回 404。
REMOTE_METRICS_URL="http://metrics.apikv.com/opentelemetry/v1/metrics"
REMOTE_LOGS_URL="https://node3-logs.apikv.com/insert/opentelemetry/v1/logs"
REMOTE_TRACES_URL="https://node3-traces.apikv.com/insert/opentelemetry/v1/traces"
