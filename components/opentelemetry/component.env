# shellcheck shell=bash
ID=opentelemetry
NAMESPACE=opentelemetry
GROUP=obs
CONFIG_VAR=ADDON_OTEL
DEFAULT_ENABLED=true
DEPENDS_ON=""   # 后端不作硬依赖: install.sh 查集群里实际装了哪些, 只为已装的后端生成 pipeline
EST_MEM_MI=200
READY_CHECK="deploy/otel-opentelemetry-collector"

HELM_REPO="open-telemetry https://open-telemetry.github.io/opentelemetry-helm-charts"
HELM_CHART="open-telemetry/opentelemetry-collector"
CHART_VERSION="0.171.0"          # collector 0.158.0；固定版本便于复现与回滚
RELEASE=otel


# 2026-08-24 曾把三条信号改推 node3(Pigsty)的 Victoria 全家桶(经 Pangolin 公网入口)以把观测负载挪出内网;
# 2026-09-03 node3 重装、Pigsty 退役, 三条信号回到集群内后端: metrics→victoriametrics,
# logs→victoria-logs(次选 loki), traces→victoria-traces(次选 jaeger)。install.sh 查集群里实际装了哪个。
# 仍要推远端时把三项填上(路径里的 /insert 前缀不能省, 原因见 install.sh 顶部), 填了就**不再写集群内后端**。
# 历史坑: 2026-08-29 node3-metrics.apikv.com 改名 metrics.apikv.com 时没同步这里, collector 对旧域名
# 拿到 404 并持续 "Exporting failed. Dropping data." —— 远端地址变更必须同步改这里并重跑 install.sh。
REMOTE_METRICS_URL=""
REMOTE_LOGS_URL=""
REMOTE_TRACES_URL=""

# 依赖契约(2026-09-11): 集群内 OTLP 采集端(仅集群内可达); 机房集群消费方定稿推 node3 外部 collector,
# 与 _external/otlp-node3 同为 otlp 提供方, 由 CC_PROVIDERS 二选一
PROVIDES=otlp
SVC=otel-opentelemetry-collector.opentelemetry.svc
PORT=4318
SCHEME=http
# remote-dev(pangolin 策略) 2026-09-23 开通: Pangolin HTTP 资源 otlp-dev(SSO 关, tlsServerName/Host=otlp.dev.test)
# → VIP:443 → gateway/httproute.yaml → collector :4319(otlp/public receiver, bearertokenauth)。
# Traefik 终止 TLS(公共泛证书), 所以 REMOTE_CA=public、ca_pem 留空。harvest 只写 endpoint 与 tls.enable=true;
# Bearer 头不在 Config Center schema 里, 走 SDK 原生 OTEL_EXPORTER_OTLP_HEADERS(Mac: ~/.config/apikv/otel.mk,
# k8s: Secret otel-auth)。token 真相源: k1 creds/otlp-public-token = Secret opentelemetry/otlp-public-auth。
HOSTNAME=otlp.dev.test
EXPOSE=http
REMOTE_HOST=otlp-dev.apikv.com
REMOTE_PORT=443
REMOTE_SCHEME=https
REMOTE_CA=public
