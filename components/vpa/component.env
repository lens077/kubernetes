# shellcheck shell=bash
ID=vpa
NAMESPACE=kube-system            # 官方默认命名空间; recommender 需读全集群 metrics
GROUP=infra
CONFIG_VAR=ADDON_VPA
DEFAULT_ENABLED=true
DEPENDS_ON="metrics-server"      # recommender 的实时用量来自 metrics-server
EST_MEM_MI=200
READY_CHECK="deploy/vpa-vertical-pod-autoscaler-recommender"   # chart fullname = <release>-<chart>-<组件>

HELM_REPO="autoscalers https://kubernetes.github.io/autoscaler"
HELM_CHART="autoscalers/vertical-pod-autoscaler"
RELEASE=vpa

EXPOSE=none                      # 只出推荐值, 无对外端点; 看推荐用 kubectl describe vpa
